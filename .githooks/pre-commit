#!/bin/sh
# 提交前自动递增 okxhttp 的 SCRIPT_VERSION：
# 只要本次提交改了 okxhttp 而版本号没变，就自动 patch+1，避免"改了脚本忘了升版本"。
set -eu
cd "$(git rev-parse --show-toplevel)"

git diff --cached --quiet -- okxhttp && exit 0

cur=$(sed -n 's/^SCRIPT_VERSION=//p' okxhttp | head -1)
[ -n "$cur" ] || exit 0

old=$(git show "HEAD:okxhttp" 2>/dev/null | sed -n 's/^SCRIPT_VERSION=//p' | head -1 || true)
[ -n "$old" ] || exit 0
[ "$cur" != "$old" ] && exit 0   # 手动升过版本就不动

new=$(printf '%s' "$cur" | awk -F. '{ if (NF >= 3) printf "%d.%d.%d", $1, $2, $3+1; else printf "%s.1", $0 }')
tmp=$(mktemp)
sed "s/^SCRIPT_VERSION=.*/SCRIPT_VERSION=$new/" okxhttp >"$tmp"
cat "$tmp" >okxhttp
rm -f "$tmp"
git add okxhttp
echo "[pre-commit] SCRIPT_VERSION: $cur -> $new"
