#!/bin/sh
# okxhttp —— Xray 多协议一键部署（VLESS-XHTTP+Argo / VLESS-TCP-REALITY-Vision / Hysteria2）
# 支持 Debian / Alpine，纯 POSIX sh（busybox ash 兼容）
set -eu

# ---------- 常量 ----------
STACK_DIR=${STACK_DIR:-/usr/local/etc/xray-stack}
BIN_DIR=${BIN_DIR:-/usr/local/bin}
XRAY_BIN=${XRAY_BIN:-$BIN_DIR/xray}
CLOUDFLARED_BIN=${CLOUDFLARED_BIN:-$BIN_DIR/cloudflared}
LEGO_BIN=${LEGO_BIN:-$BIN_DIR/lego}
TLS_DIR=${TLS_DIR:-$STACK_DIR/certs}
STATE=${STATE:-$STACK_DIR/stack.conf}
CONFIG=${CONFIG:-$STACK_DIR/config.json}
ARGO_LOG=${ARGO_LOG:-$STACK_DIR/argo.log}
ARGO_PID=${ARGO_PID:-$STACK_DIR/argo.pid}
# 协议入站 tag：模板与链接生成共用，避免两处硬编码
TAG_XHTTP=vless-xhttp-in
TAG_WS=vless-ws-in
TAG_REALITY=vless-reality-in
TAG_HY2=hy2-in

# 默认值：只在这里定义一次
DEF_XHTTP_PORT=2087
DEF_REALITY_PORT=443
DEF_HY2_PORT=443
DEF_REALITY_SNI=pic.bstarstatic.com
DEF_LE_EMAIL=ops@no-reply.dev
DEF_WARP_ENDPOINT=engage.cloudflareclient.com:2408 # WARP 端点（域名，按 DNS 解析，不写死 IP）
DEF_PROBE_HOST=www.cloudflare.com # 出站探测目标（域名，按 A/AAAA 解析，不写死 IP）
DEF_TRACE_PATH=/cdn-cgi/trace
HOSTS_FILE=${HOSTS_FILE:-/etc/hosts}     # 系统 DNS 解析不了时，用 DoH 结果补在这里（带标记，卸载时移除）
# shell 侧 DoH 兜底：两个协议族都列上，不可达的会立刻失败并跳到下一个
DEF_DOH_V4="https://1.1.1.1/dns-query https://8.8.8.8/resolve"
DEF_DOH_V6="https://[2606:4700:4700::1111]/dns-query https://[2001:4860:4860::8888]/resolve"
DOH_SERVERS=${DOH_SERVERS:-"$DEF_DOH_V4 $DEF_DOH_V6"}
# Xray 内置 DNS：上游用域名 DoH，dns.hosts 里给一对 IP 做 bootstrap（解析 DoH 域名本身不依赖系统 DNS）
DEF_XRAY_DOH_SERVERS='["https://cloudflare-dns.com/dns-query","https://dns.google/dns-query"]'
DEF_XRAY_DOH_HOSTS='{"cloudflare-dns.com":["1.1.1.1","2606:4700:4700::1111"],"dns.google":["8.8.8.8","2001:4860:4860::8888"]}'
SUB_URL=${SUB_URL:-https://note.linkof.link} # 订阅托管（AnyNote：POST /set，GET /<key> 读原文）
DEF_ARGO_TIMEOUT=240 # Argo 注册/ingress 探测超时：cloudflared 自己 quic→http2 回退实测可达 ~3 分钟
WARP_FILE=${WARP_FILE:-$STACK_DIR/warp.json}
SELF_URL=${SELF_URL:-https://raw.githubusercontent.com/banbendalao/okxhttp/main/okxhttp}
SCRIPT_VERSION=1.1.51

# shellcheck disable=SC2034 # 测试用来断言 sourcing 不执行 main
MAIN_RAN=''

log_info() { printf '\033[32m[*]\033[0m %s\n' "$*"; }
log_warn() { printf '\033[33m[!]\033[0m %s\n' "$*" >&2; }
log_err() { printf '\033[31m[x]\033[0m %s\n' "$*" >&2; }
die() {
  log_err "$*"
  exit 1
}


# 一张表描述所有入站：标签 / 开关变量 / 端口变量 / 传输层 / 环境变量名 / 默认端口
# 新增协议只改这里，渲染、状态、预检、端口修改全部由循环驱动
DEF_WS_PORT=2088
PROTO_SPECS="
$TAG_XHTTP ENABLE_XHTTP XHTTP_PORT tcp XHTTP $DEF_XHTTP_PORT
$TAG_WS ENABLE_WS WS_PORT tcp - $DEF_WS_PORT
$TAG_REALITY ENABLE_REALITY REALITY_PORT tcp REALITY $DEF_REALITY_PORT
$TAG_HY2 ENABLE_HY2 HY2_PORT udp HY2 $DEF_HY2_PORT
"

# 调度服务（每 60s 比对节点、每天查证书）
SVC_SCHED=okxhttp
SCHED_TICK=${SCHED_TICK:-60}
SCHED_RENEW_EVERY=${SCHED_RENEW_EVERY:-86400}

# ---------- 工具 ----------
rand_hex() { od -An -tx1 -N "${1:-8}" /dev/urandom | tr -d ' \n'; }
rand_str() { LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | dd bs=1 count="${1:-16}" 2>/dev/null; }
command_exists() { command -v "$1" >/dev/null 2>&1; }

_has_inbound() { # tag —— 当前 config 里是否已有该入站
  [ -s "$CONFIG" ] && jq -e --arg t "$1" 'any(.inbounds[]; .tag == $t)' "$CONFIG" >/dev/null 2>&1
}

_pick_free_port() { # [要排除的端口...] -> 10000-65535 的空闲端口
  _tries=0
  while [ "$_tries" -lt 30 ]; do
    _cand=$((10000 + $(od -An -N2 -tu2 /dev/urandom | tr -d ' ') % 55536))
    _skip=
    for _ex in "$@"; do [ "$_cand" = "$_ex" ] && _skip=1; done
    if [ -z "$_skip" ] && ! port_in_use tcp "$_cand"; then
      printf '%s' "$_cand"
      return 0
    fi
    _tries=$((_tries + 1))
  done
  printf '%s' "$DEF_XHTTP_PORT"
}
need_root() { [ "$(id -u)" -eq 0 ] || die "需要 root 运行"; }

_cleanup() { # 失败/退出时不留下半成品（临时渲染目录、半写文件）
  rm -rf "$STACK_DIR/.render" 2>/dev/null || true
  rm -f "$STATE".parsed "$STATE".tmp "$STATE".tmp2 2>/dev/null || true
  rm -f "$CONFIG".new.json "$CONFIG".prev 2>/dev/null || true
}


# ---------- 密钥与证书 ----------
_xray() {
  if [ -x "$XRAY_BIN" ]; then printf '%s\n' "$XRAY_BIN"; else command -v xray || die "未找到 xray"; fi
}

gen_uuid() { "$(_xray)" uuid; }

gen_x25519() {
  _out=$("$(_xray)" x25519) || return 1
  _priv=$(printf '%s\n' "$_out" | sed -n 's/^PrivateKey: //p')
  _pub=$(printf '%s\n' "$_out" | sed -n 's/^Password (PublicKey): //p')
  [ -n "$_priv" ] && [ -n "$_pub" ] || return 1
  printf 'PRIVATE_KEY=%s\nPUBLIC_KEY=%s\n' "$_priv" "$_pub"
}

gen_shortid() { rand_hex 4; }
gen_password() { rand_str 24; }

gen_self_cert() { # cn dir san_ip
  _cn=$1
  _dir=$2
  _ip=${3:-}
  mkdir -p "$_dir"
  _san="DNS:$_cn"
  [ -n "$_ip" ] && _san="$_san,IP:$_ip"
  openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
    -keyout "$_dir/key.pem" -out "$_dir/cert.pem" -days 365 \
    -subj "/CN=$_cn" -addext "subjectAltName=$_san" >/dev/null 2>&1 || die "自签证书生成失败"
  chmod 600 "$_dir/key.pem"
}

cert_pin_sha256() { # 输出 64 位 hex（Xray 的 pinnedPeerCertSha256 与 hysteria 的 pinSHA256 都吃 hex）
  openssl x509 -in "$1" -outform DER | openssl dgst -sha256 -hex | sed 's/.*= *//'
}

_cert_pin_hex() { # 当前证书指纹（无证书则不输出）
  [ -s "$TLS_DIR/cert.pem" ] || return 1
  _ph=$(cert_pin_sha256 "$TLS_DIR/cert.pem" 2>/dev/null) || return 1
  [ -n "$_ph" ] || return 1
  printf '%s' "$_ph"
}

check_reality_dest() { # sni
  _out=$(timeout 8 openssl s_client -connect "$1:443" -servername "$1" -tls1_3 -alpn h2 </dev/null 2>/dev/null || true)
  printf '%s' "$_out" | grep -q 'TLSv1.3' || return 1
  printf '%s' "$_out" | grep -qi 'ALPN protocol: h2' || return 1
  return 0
}

fetch_lego() {
  command_exists lego && {
    LEGO_BIN=$(command -v lego)
    return 0
  }
  [ -x "$LEGO_BIN" ] && return 0
  case "$(uname -m)" in
    x86_64 | amd64) _a=amd64 ;;
    aarch64 | arm64) _a=arm64 ;;
    *) die "lego 不支持该架构: $(uname -m)" ;;
  esac
  _url=$(curl -fsSL --max-time 15 https://api.github.com/repos/go-acme/lego/releases/latest 2>/dev/null \
    | jq -r '.assets[] | select(.name | test("linux_" + $a + "[.]tar[.]gz$")) | .browser_download_url' --arg a "$_a" 2>/dev/null | head -1)
  [ -n "$_url" ] || die "无法解析 lego 下载地址"
  mkdir -p "$BIN_DIR"
  _tgz="$BIN_DIR/.lego.tgz"
  fetch_dl "$_url" "$_tgz" || die "lego 下载失败"
  tar xzf "$_tgz" -C "$BIN_DIR" lego || die "lego 解压失败"
  rm -f "$_tgz"
  chmod +x "$BIN_DIR/lego"
  LEGO_BIN="$BIN_DIR/lego"
}


_lego_run() { # ip [额外参数...] —— 取/续 LE 证书到 $TLS_DIR/lego（180s 兜底，不随机 sleep）
  _lr_ip=$1
  shift
  fetch_lego || return 1
  mkdir -p "$TLS_DIR/lego"
  timeout 180 "$LEGO_BIN" run --accept-tos --email "${LE_EMAIL:-$DEF_LE_EMAIL}" \
    --path "$TLS_DIR/lego" --http --profile shortlived -d "$_lr_ip" --no-random-sleep "$@" \
    >>"$STACK_DIR/lego.log" 2>&1
}

_install_le_files() { # ip —— lego 产出的证书装到 cert.pem/key.pem
  _lc="$TLS_DIR/lego/certificates/$1.crt"
  _lk="$TLS_DIR/lego/certificates/$1.key"
  [ -s "$_lc" ] && [ -s "$_lk" ] || return 1
  cp "$_lc" "$TLS_DIR/cert.new.pem" && cp "$_lk" "$TLS_DIR/key.new.pem" || return 1
  chmod 600 "$TLS_DIR/key.new.pem"
  mv "$TLS_DIR/cert.new.pem" "$TLS_DIR/cert.pem"
  mv "$TLS_DIR/key.new.pem" "$TLS_DIR/key.pem"
}

install_sched_service() {
  [ "${SUB:-yes}" = yes ] || [ "${HY2_CERT:-self}" = le ] || return 0
  [ -x "$BIN_DIR/okxhttp" ] || return 0
  svc_install "$SVC_SCHED" "$BIN_DIR/okxhttp --daemon"
  log_info "调度服务已就绪（每 ${SCHED_TICK}s 同步订阅，每天检查证书）"
}

_cert_tick() { # 每天最多跑一次续期
  _is_le_cert "$TLS_DIR/cert.pem" || return 0
  _marker="$STACK_DIR/.renew_checked"
  if [ -f "$_marker" ]; then
    _last=$(date -r "$_marker" +%s 2>/dev/null || echo 0)
    [ $(( $(date +%s) - _last )) -lt "${SCHED_RENEW_EVERY:-86400}" ] && return 0
  fi
  log_info "检查证书是否到期…"
  do_renew >/dev/null 2>&1 && log_info "证书检查完成" || log_warn "证书续期失败（旧证书继续生效）"
  : >"$_marker"
}

_sched_nap() { # 可被 TERM 立即打断的 sleep
  sleep "$1" &
  wait $! 2>/dev/null || true
}

do_daemon() {
  trap 'log_info "调度服务退出"; exit 0' TERM INT
  load_state
  log_info "调度服务启动（每 ${SCHED_TICK}s 比对节点、每天查证书）"
  while :; do
    sub_sync >/dev/null 2>&1 || true
    _cert_tick || true
    _sched_nap "${SCHED_TICK:-60}"
  done
}



_deployed() { [ -f "$STATE" ] || [ -s "$CONFIG" ]; }

_do_install() {
  need_root
  load_state
  collect_config
  install_all
}

_argo_on() { [ "${ENABLE_XHTTP:-0}" = 1 ] && [ "${ARGO_MODE:-temp}" != off ]; }

_lbl() { # vless-xhttp-in -> xhttp
  _l=${1#vless-}
  printf '%s' "${_l%-in}"
}

_proto_field() { # tag 字段序号(1..6) —— 从表里取某个入站的元数据
  _pf_tag=$1
  _pf_n=$2
  # shellcheck disable=SC2086
  set -- $PROTO_SPECS
  while [ $# -ge 6 ]; do
    if [ "$1" = "$_pf_tag" ]; then
      eval "printf '%s' \"\$$_pf_n\""
      return 0
    fi
    shift 6
  done
  return 1
}

_tag_of_var() { # ENABLE_HY2 -> 显示名（hy2）
  _tv=$1
  # shellcheck disable=SC2086
  set -- $PROTO_SPECS
  while [ $# -ge 6 ]; do
    if [ "$2" = "$_tv" ]; then
      _lbl "$1"
      return 0
    fi
    shift 6
  done
}

_toggle_vars() { # 菜单里可切换的协议开关（表里除 ws 之外的开关变量名）
  _tvars=
  # shellcheck disable=SC2086
  set -- $PROTO_SPECS
  while [ $# -ge 6 ]; do
    [ "$5" != "-" ] && _tvars="$_tvars $2"
    shift 6
  done
  printf '%s' "${_tvars# }"
}

_proto_each() { # 回调 tag port net —— 遍历启用的入站（同一 shell，回调可 die / 读 stdin）
  _cb=$1
  # shellcheck disable=SC2086
  set -- $PROTO_SPECS # 表里每行 6 个字段，按默认 IFS 分词（不临时改 IFS，避免污染被调用函数）
  while [ $# -ge 6 ]; do
    _p_tag=$1 _p_var=$2 _p_pvar=$3 _p_net=$4 _p_dport=$6
    _p_on='' _p_port=''
    shift 6
    eval "_p_on=\${$_p_var:-0}"
    [ "$_p_on" = 1 ] || continue
    case "$_p_tag" in
      "$TAG_XHTTP" | "$TAG_WS") [ "${_DIRECT_ONLY:-0}" = 1 ] && continue ;;
    esac
    [ "$_p_tag" = "$TAG_XHTTP" ] && [ "${EXPOSE_WS:-0}" = 1 ] && continue
    eval "_p_port=\${$_p_pvar:-$_p_dport}"
    $_cb "$_p_tag" "$_p_port" "$_p_net"
  done
  return 0
}

# ---------- 配置模板与合成（模板只存在于内存，不落盘） ----------
_tpl_xhttp() {
  cat <<'JQ'
{
  tag: $tag, listen: $listen, port: $port, protocol: "vless",
  settings: {clients: [{id: $uuid}], decryption: "none"},
  streamSettings: {
    network: "xhttp", security: "none",
    xhttpSettings: {path: $path, mode: "auto"}
  },
  sniffing: {enabled: true, destOverride: ["http", "tls", "quic"]}
}
JQ
}

_tpl_ws() {
  cat <<'JQ'
{
  tag: $tag, listen: $listen, port: $port, protocol: "vless",
  settings: {clients: [{id: $uuid}], decryption: "none"},
  streamSettings: {network: "ws", security: "none", wsSettings: {path: $path}},
  sniffing: {enabled: true, destOverride: ["http", "tls", "quic"]}
}
JQ
}

_tpl_reality() {
  cat <<'JQ'
{
  tag: $tag, listen: $listen, port: $port, protocol: "vless",
  settings: {clients: [{id: $uuid, flow: "xtls-rprx-vision"}], decryption: "none"},
  streamSettings: {
    network: "tcp", security: "reality",
    realitySettings: {
      show: false, dest: $dest, xver: 0,
      serverNames: [$sni], privateKey: $priv, shortIds: [$sid]
    }
  },
  sniffing: {enabled: true, destOverride: ["http", "tls", "quic"]}
}
JQ
}

_tpl_hy2() {
  cat <<'JQ'
{
  tag: $tag, listen: $listen, port: $port, protocol: "hysteria",
  settings: {version: 2, clients: [{auth: $auth}]},
  streamSettings: ({
    network: "hysteria", security: "tls",
    tlsSettings: {alpn: ["h3"], certificates: [{certificateFile: $cert, keyFile: $key}]},
    quicParams: {congestion: "brutal", brutalUp: $up, brutalDown: $down}
  } | if $up == "" then del(.quicParams) else . end),
  sniffing: {enabled: true, destOverride: ["http", "tls", "quic"]}
}
JQ
}

_tpl_merge() {
  cat <<'JQ'
{
  log: {loglevel: "warning"},
  inbounds: .,
  outbounds: ([{tag: "direct", protocol: "freedom",
                streamSettings: {sockopt: {domainStrategy: $freedom}}}] + $extra
              + [{tag: "block", protocol: "blackhole"}]),
  routing: {rules: $rules}
} + (if $dns == null then {} else {dns: $dns} end)
JQ
}

render_inbound() { # proto outfile
  _p=$1
  _dst=$2
  case "$_p" in
    xhttp)
      jq -n "$(_tpl_xhttp)" --arg tag "$TAG_XHTTP" \
        --arg uuid "${UUID:?UUID 未设置}" \
        --argjson port "${XHTTP_PORT:-$DEF_XHTTP_PORT}" \
        --arg path "${XHTTP_PATH:-/xhttp}" \
        --arg listen "$([ "${ARGO_MODE:-temp}" = off ] && printf '%s' "$LISTEN_ANY" || printf '%s' "$LISTEN_LOCAL")" >"$_dst"
      ;;
    reality)
      jq -n "$(_tpl_reality)" --arg tag "$TAG_REALITY" \
        --arg uuid "${UUID:?UUID 未设置}" \
        --argjson port "${REALITY_PORT:-$DEF_REALITY_PORT}" \
        --arg listen "$LISTEN_ANY" \
        --arg dest "${REALITY_SNI:-$DEF_REALITY_SNI}:443" \
        --arg sni "${REALITY_SNI:-$DEF_REALITY_SNI}" \
        --arg priv "${REALITY_PRIV:?REALITY 私钥未设置}" \
        --arg sid "${REALITY_SHORTID:?shortId 未设置}" >"$_dst"
      ;;
    ws)
      jq -n "$(_tpl_ws)" --arg tag "$TAG_WS" \
        --arg uuid "${UUID:?UUID 未设置}" \
        --arg listen "$LISTEN_LOCAL" \
        --argjson port "${WS_PORT:-$((XHTTP_PORT + 1))}" \
        --arg path "${WS_PATH:-/ws}" >"$_dst"
      ;;
    hy2)
      jq -n "$(_tpl_hy2)" --arg tag "$TAG_HY2" \
        --arg auth "${HY2_PASSWORD:?hy2 密码未设置}" \
        --arg listen "$LISTEN_ANY" \
        --argjson port "${HY2_PORT:-$DEF_HY2_PORT}" \
        --arg cert "$TLS_DIR/cert.pem" \
        --arg key "$TLS_DIR/key.pem" \
        --arg up "${HY2_BRUTAL_UP:+$HY2_BRUTAL_UP mbps}" \
        --arg down "${HY2_BRUTAL_DOWN:+$HY2_BRUTAL_DOWN mbps}" >"$_dst"
      ;;
    *) die "未知协议: $_p" ;;
  esac
}

_render_inbound_file() { # tag port net
  _n=$((_n + 1))
  render_inbound "$(_lbl "$1")" "$_tmpd/$(printf '%02d' "$_n")-$(_lbl "$1").json"
}

test_config() { # file
  [ -s "$1" ] || return 1
  if _err=$("$(_xray)" run -test -c "$1" 2>&1); then
    return 0
  fi
  log_err "配置校验失败: $1"
  printf '%s\n' "$_err" | tail -30 >&2
  return 1
}

build_config() { # outfile
  _cfgout=$1
  _n=0
  _tmpd=$STACK_DIR/.render
  rm -rf "$_tmpd"
  mkdir -p "$_tmpd"
  _n=0
  _proto_each _render_inbound_file
  [ "$_n" -gt 0 ] || die "至少需要启用一个协议"
  # 先写临时文件，校验通过才原子替换（失败不破坏正在使用的配置）
  # shellcheck disable=SC2086
  _new="$_cfgout.new.json" # 保留 .json 后缀，xray 靠扩展名判断格式
  _extra='[]'
  _rules='[]'
  # 拨号策略跟随实际可用的协议族：DNS 两族都返回，由拨号器选可达的
  _dial=UseIP
  WARP_DIAL=ForceIPv4
  case "$(detect_ip_family)" in
    4) _dial=UseIPv4 ;;
    6) _dial=UseIPv6; WARP_DIAL=ForceIPv6 ;;
  esac
  export WARP_DIAL
  if [ "${WARP_ENABLED:-0}" = 1 ]; then
    _extra=$(warp_outbounds) || die "WARP 出站渲染失败（检查 $WARP_FILE）"
    [ -n "$_extra" ] && [ "$_extra" != "null" ] || die "WARP 出站渲染为空"
    _rules=$(warp_rules)
    # WARP 承载全部流量时，Xray 自己的 DoH 请求也会被路由进 WARP（端点又要靠 DoH 解析 → 死循环）。
    # DoH 拨号用的是 hosts 解析出来的 IP，所以按 IP 把这些端点钉死走 direct。
    if [ "${DNS_DOH:-yes}" = yes ]; then
      _doh_ips=$(printf '%s' "$DEF_XRAY_DOH_HOSTS" | jq -c '[.[][]]')
      # DoH 拨号目标可能是域名（先匹配 domain），也可能是 hosts 解析后的 IP（再匹配 ip），两条都钉住
      _rules=$(jq -nc --argjson base "$_rules" --argjson ips "$_doh_ips" \
        '[{type: "field", domain: ["full:cloudflare-dns.com", "full:dns.google"], outboundTag: "direct"},
          {type: "field", ip: $ips, outboundTag: "direct"}] + $base')
    fi
  fi
  # Xray 内置 DNS：走 DoH（IP 直连，不依赖系统 DNS）
  _freedom=AsIs
  _dns='null'
  if [ "${DNS_DOH:-yes}" = yes ]; then
    _freedom=$_dial
    # 查询策略跟随实际可用的协议族，避免纯 v4 机器拿到 AAAA 后连不上
    # queryStrategy 不指定，交给内核默认（USE_IP：A/AAAA 都查，由拨号器选可达的）
    _dns=$(jq -nc --argjson s "$DEF_XRAY_DOH_SERVERS" --argjson h "$DEF_XRAY_DOH_HOSTS" \
      '{servers: $s, hosts: $h}')
  fi
  # shellcheck disable=SC2086
  jq -s --argjson extra "$_extra" --argjson rules "$_rules" \
    --arg freedom "$_freedom" --argjson dns "$_dns" \
    "$(_tpl_merge)" "$_tmpd"/*.json >"$_new" || die "配置合成失败"
  rm -rf "$_tmpd"
  chmod 600 "$_new" # 里面含 REALITY 私钥与 hy2 密码
  test_config "$_new" || {
    rm -f "$_new"
    die "生成的配置未通过 xray 校验（旧配置未改动）"
  }
  mv "$_new" "$_cfgout"
}

# ---------- Argo 隧道 ----------
argo_domain_from_log() {
  [ -f "$1" ] || return 0
  grep -aoE 'https://[a-z0-9][a-z0-9-]*\.trycloudflare\.com' "$1" 2>/dev/null | head -1 | sed 's#^https://##'
}

argo_ingress_port() {
  [ -f "$1" ] || return 0
  grep -ao 'localhost:[0-9][0-9]*' "$1" 2>/dev/null | head -1 | cut -d: -f2
}

argo_log_connected() {
  [ -f "$1" ] || return 1
  grep -aq 'Registered tunnel connection' "$1"
}

doh_query() { # name rrtype code —— 依次问 1.1.1.1 / 8.8.8.8 的 DoH，打印答案
  for _doh in $DOH_SERVERS; do
    _resp=$(curl -s -m 8 -H 'accept: application/dns-json' "$_doh?name=$1&type=$2" 2>/dev/null) || continue
    _ans=$(printf '%s' "$_resp" | jq -r --argjson t "$3" '.Answer[]? | select(.type == $t) | .data' 2>/dev/null | head -5)
    if [ -n "$_ans" ]; then
      printf '%s\n' "$_ans"
      return 0
    fi
  done
  return 1
}

sys_resolve() { # name —— 系统 DNS 能否解析
  if command_exists getent; then
    getent hosts "$1" >/dev/null 2>&1 && return 0
  elif command_exists nslookup; then
    nslookup "$1" 2>/dev/null | grep -q 'Address' && return 0
  else
    curl -sfS -m 5 -o /dev/null "http://$1/" 2>/dev/null && return 0
  fi
  return 1
}

_remove_hosts_block() {
  [ -f "$HOSTS_FILE" ] || return 0
  grep -v '^# >>> okxhttp-doh' "$HOSTS_FILE" | grep -v '^# <<< okxhttp-doh' | grep -v 'okxhttp-doh-managed' >"$HOSTS_FILE.tmp" 2>/dev/null || : >"$HOSTS_FILE.tmp"
  cat "$HOSTS_FILE.tmp" >"$HOSTS_FILE"
  rm -f "$HOSTS_FILE.tmp"
}

ensure_hosts_entry() { # name —— 系统解析不了就用 DoH 结果写 hosts（幂等）
  _n=$1
  sys_resolve "$_n" && return 0
  _ip4=$(doh_query "$_n" A 1 | head -1)
  _ip6=$(doh_query "$_n" AAAA 28 | head -1)
  if [ -z "$_ip4" ] && [ -z "$_ip6" ]; then
    log_warn "系统 DNS 与 DoH 都无法解析 $_n"
    return 1
  fi
  log_info "系统 DNS 解析不了 $_n，改用 DoH 得到 ${_ip4:-}${_ip4:+ }${_ip6:-} 并写入 $HOSTS_FILE"
  _remove_hosts_block
  {
    printf '# >>> okxhttp-doh（系统 DNS 不可用时由 DoH 解析，卸载会移除）>>>\n'
    [ -n "$_ip4" ] && printf '%s %s # okxhttp-doh-managed\n' "$_ip4" "$_n"
    [ -n "$_ip6" ] && printf '%s %s # okxhttp-doh-managed\n' "$_ip6" "$_n"
    printf '# <<< okxhttp-doh <<<\n'
  } >>"$HOSTS_FILE"
  return 0
}

_trace() { # -4|-6 → 打印本机经该协议族的出口 IP（失败为空）
  curl "$1" -fsS -m 5 "https://$DEF_PROBE_HOST$DEF_TRACE_PATH" 2>/dev/null | sed -n 's/^ip=//p' | head -1
}

_probe_all() { # 合并探测：一次拿到 v4/v6 出口 IP（供公网 IP 与协议族判定共用）
  _PROBED=1
  ensure_hosts_entry "$DEF_PROBE_HOST" >/dev/null 2>&1 || true # DNS 挂了也能探测
  PROBE_IP_V4=$(_trace -4)
  PROBE_IP_V6=$(_trace -6)
}

detect_ip_family() { # 输出 4 / 6 / 46 / 空：v4 可用、v6 可用、双栈、都不通
  [ -n "${_PROBED:-}" ] || _probe_all
  _f=
  if [ -n "${PROBE_IP_V4:-}" ]; then _f=4; fi
  if [ -n "${PROBE_IP_V6:-}" ]; then _f="${_f}6"; fi
  printf '%s' "$_f"
}

argo_edge_args() { # 用 DoH 解析边缘域名，输出 --edge <ip>:7844（跳过 cloudflared 的 SRV 查询）
  _fam=$(detect_ip_family)
  _out=
  for _r in region1.v2.argotunnel.com region2.v2.argotunnel.com; do
    case "$_fam" in
      *4*)
        for _ip in $(doh_query "$_r" A 1 2>/dev/null | head -2); do
          _out="$_out --edge $_ip:7844"
        done
        ;;
    esac
    case "$_fam" in
      *6*)
        for _ip in $(doh_query "$_r" AAAA 28 2>/dev/null | head -2); do
          _out="$_out --edge [$_ip]:7844"
        done
        ;;
    esac
  done
  printf '%s' "${_out# }"
}

_argo_launch() { # 只启动一个连接器；协议与 IP 族由 cloudflared 自己选（--protocol auto / --edge-ip-version auto）
  _mp=${ARGO_PROTO:-auto}
  if [ "${ARGO_MODE:-temp}" = token ]; then
    _acmd="$CLOUDFLARED_BIN tunnel --no-autoupdate --edge-ip-version auto --protocol $_mp ${ARGO_EDGE_ARGS:-} run --token ${ARGO_AUTH:-}"
  else
    _tport=${XHTTP_PORT:-2087}
    [ "${ENABLE_WS:-0}" = 1 ] && _tport=${WS_PORT:-$((XHTTP_PORT + 1))}
    _acmd="$CLOUDFLARED_BIN tunnel --url http://[::1]:$_tport --no-autoupdate --edge-ip-version auto --protocol $_mp ${ARGO_EDGE_ARGS:-}"
  fi
  if [ "${INIT_SYS:-none}" = none ]; then
    $_acmd >>"$ARGO_LOG" 2>&1 &
    _argonpid=$!
    printf '%s\n' "$_argonpid" >>"$ARGO_PID"
  else
    SVC_LOG=$ARGO_LOG svc_install argo "$_acmd"
  fi
}

_argo_wait_connected() { # log timeout
  _i=0
  _hinted=0
  while [ "$_i" -lt "${2:-$DEF_ARGO_TIMEOUT}" ]; do
    argo_log_connected "$1" && return 0
    if [ "$_hinted" = 0 ] && [ "$_i" -ge 15 ]; then
      log_warn "cloudflared 仍在尝试 quic，等它自己回退 http2（最长 ${2:-$DEF_ARGO_TIMEOUT}s）…"
      _hinted=1
    fi
    sleep 1
    _i=$((_i + 1))
  done
  return 1
}

argo_stop() {
  if [ "${INIT_SYS:-none}" != none ] && { [ -f /etc/init.d/argo ] || [ -f /etc/systemd/system/argo.service ]; }; then
    svc_stop argo
  fi
  [ -f "$ARGO_PID" ] || return 0
  while read -r _p; do
    [ -n "$_p" ] || continue
    kill "$_p" 2>/dev/null || true
  done <"$ARGO_PID"
  rm -f "$ARGO_PID"
}

# token 模式：先短跑一次连接器，从日志读出面板下发的 ingress 端口并对齐 XHTTP_PORT
argo_probe_ingress() {
  [ "${ARGO_MODE:-temp}" = token ] || return 0
  [ -n "${ARGO_AUTH:-}" ] || die "token 模式需要 ARGO_AUTH"
  log_info "探测面板 ingress 配置（最长 ${DEF_ARGO_TIMEOUT}s）…"
  : >"$ARGO_LOG"
  "$CLOUDFLARED_BIN" tunnel --no-autoupdate --edge-ip-version auto --protocol "${ARGO_PROTO:-auto}" ${ARGO_EDGE_ARGS:-} \
    run --token "$ARGO_AUTH" >"$ARGO_LOG" 2>&1 &
  _probe=$!
  _ins=
  _i=0
  while [ "$_i" -lt "$DEF_ARGO_TIMEOUT" ]; do
    _ins=$(argo_ingress_port "$ARGO_LOG")
    [ -n "$_ins" ] && break
    sleep 1
    _i=$((_i + 1))
  done
  kill "$_probe" 2>/dev/null || true
  wait "$_probe" 2>/dev/null || true
  if [ -z "$_ins" ]; then
    log_warn "未能从日志读到面板 ingress；请确认面板中 $ARGO_DOMAIN 指向 http://localhost:${XHTTP_PORT:-$DEF_XHTTP_PORT}"
    return 1
  fi
  if [ "$_ins" != "${XHTTP_PORT:-$DEF_XHTTP_PORT}" ]; then
    log_warn "面板 ingress 指向 localhost:$_ins，XHTTP_PORT 由 ${XHTTP_PORT:-$DEF_XHTTP_PORT} 自动对齐为 $_ins"
    XHTTP_PORT=$_ins
  fi
  return 0
}

argo_start() {
  [ "${ARGO_MODE:-temp}" = off ] && {
    log_info "ARGO_MODE=off：跳过隧道，XHTTP 将直接监听公网"
    return 0
  }
  mkdir -p "$STACK_DIR"
  argo_stop
  : >"$ARGO_LOG"
  : >"$ARGO_PID"
  log_info "启动 Argo 连接器（protocol=${ARGO_PROTO:-auto}，mode=${ARGO_MODE:-temp}）…"
  _argo_launch
  if ! _argo_wait_connected "$ARGO_LOG" "$DEF_ARGO_TIMEOUT"; then
    tail -20 "$ARGO_LOG" >&2
    die "Argo 隧道注册失败（cloudflared 已自行尝试 quic/http2）"
  fi
  # cloudflared 自己选的协议，从日志里读出来展示
  ARGO_PROTO_USED=$(grep -aoE 'protocol=[a-z0-9]+' "$ARGO_LOG" 2>/dev/null | head -1 | cut -d= -f2)
  if [ "${ARGO_MODE:-temp}" = token ]; then
    ARGO_DOMAIN_RESOLVED=${ARGO_DOMAIN:-}
    [ -n "$ARGO_DOMAIN_RESOLVED" ] || die "token 模式需要 ARGO_DOMAIN"
  else
    ARGO_DOMAIN_RESOLVED=$(argo_domain_from_log "$ARGO_LOG")
    [ -n "$ARGO_DOMAIN_RESOLVED" ] || die "未从 cloudflared 日志取到临时隧道域名（见 $ARGO_LOG）"
  fi
  log_info "Argo 就绪：domain=$ARGO_DOMAIN_RESOLVED prot=${ARGO_PROTO_USED:-?}"
}

# ---------- 分享链接（由部署现状推导） ----------
_argo_domain_live() { # 优先从 argo 日志读实际域名（面板 hostname 或临时隧道域名）
  _d=
  if [ -f "$ARGO_LOG" ]; then
    # cloudflared 日志里的 JSON 是转义过的："hostname":"example.com"
    # 取最后一次下发（面板改域名后 tail 才是当前值）
    _d=$(grep -aoE '\\?"hostname\\?":\\?"[^"\\]+' "$ARGO_LOG" 2>/dev/null | tail -1 | sed -E 's/.*://; s/\\?"//g')
    [ -n "$_d" ] || _d=$(grep -aoE 'https://[a-z0-9-]+\.trycloudflare\.com' "$ARGO_LOG" 2>/dev/null | tail -1 | sed 's#https://##')
  fi
  [ -n "$_d" ] || _d=${ARGO_DOMAIN:-}
  printf '%s' "$_d"
}

_reality_pub() { # 从配置里的私钥现场推导公钥（推导不出才用状态值）
  _priv=$(jq -r --arg t "$TAG_REALITY" '.inbounds[]|select(.tag==$t)|.streamSettings.realitySettings.privateKey' "$CONFIG" 2>/dev/null)
  if [ -n "$_priv" ] && [ -x "${XRAY_BIN:-}" ]; then
    _pub=$("$XRAY_BIN" x25519 -i "$_priv" 2>/dev/null | sed -n 's/^Password (PublicKey): //p')
    [ -n "$_pub" ] && {
      printf '%s' "$_pub"
      return 0
    }
  fi
  printf '%s' "${REALITY_PUB:-}"
}

_cert_is_public() { # 证书是否公信（LE 等）：链接与状态都以此为准
  [ -s "$TLS_DIR/cert.pem" ] || return 1
  openssl x509 -in "$TLS_DIR/cert.pem" -noout -issuer 2>/dev/null | grep -q "Let's Encrypt"
}

_link_fields() { # 一次读出入站字段，输出可 eval 的 KEY=VALUE
  jq -r --arg tx "$TAG_XHTTP" --arg tw "$TAG_WS" --arg tr "$TAG_REALITY" --arg th "$TAG_HY2" '
    ([.inbounds[] | select(.tag == $tx)][0] // {}) as $x
    | ([.inbounds[] | select(.tag == $tw)][0] // {}) as $w
    | ([.inbounds[] | select(.tag == $tr)][0] // {}) as $r
    | ([.inbounds[] | select(.tag == $th)][0] // {}) as $h
    | {
        _uuid_x: $x.settings.clients[0].id,
        _path_x: $x.streamSettings.xhttpSettings.path,
        _port_x: ($x.port // "" | tostring),
        _listen_x: $x.listen,
        _uuid_w: $w.settings.clients[0].id,
        _path_w: $w.streamSettings.wsSettings.path,
        _uuid_r: $r.settings.clients[0].id,
        _port_r: ($r.port // "" | tostring),
        _sni_r: $r.streamSettings.realitySettings.serverNames[0],
        _sid_r: $r.streamSettings.realitySettings.shortIds[0],
        _auth_h: $h.settings.clients[0].auth,
        _port_h: ($h.port // "" | tostring)
      }
    | to_entries[] | select(.value != null and .value != "")
    | "\(.key)=\(.value | @sh)"' "$CONFIG" 2>/dev/null
}

gen_links() { # 由当前部署现场生成分享链接（不落盘）
  [ -s "$CONFIG" ] || {
    log_warn "未找到服务端配置: $CONFIG"
    return 1
  }
  load_state
  _name=${NODE_NAME:-$(hostname 2>/dev/null || echo node)}
  _ip=${PUBLIC_IP:-$(public_ip)}
  _iph=$(_bracket "$_ip") # URL 里的 host 部分（IPv6 需 []）
  _dom=$(_argo_domain_live)

  _uuid_x='' _path_x='' _port_x='' _listen_x='' _uuid_w='' _path_w=''
  _uuid_r='' _port_r='' _sni_r='' _sid_r='' _auth_h='' _port_h=''
  eval "$(_link_fields)" # 一次 jq 取出所有入站字段
  _pub_r=$(_reality_pub)

  if [ -n "$_uuid_w" ]; then
    printf 'vless://%s@%s:443?encryption=none&security=tls&sni=%s&fp=chrome&type=ws&path=%s&host=%s#%s-ws-h2\n' \
      "$_uuid_w" "$_dom" "$_dom" "${_path_w:-/ws}" "$_dom" "$_name"
  elif [ -n "$_uuid_x" ]; then
    if _is_loopback "$_listen_x"; then
      printf 'vless://%s@%s:443?encryption=none&security=tls&sni=%s&alpn=h2&fp=chrome&type=xhttp&path=%s&mode=auto&host=%s#%s-xhttp-h2\n' \
        "$_uuid_x" "$_dom" "$_dom" "$_path_x" "$_dom" "$_name"
      printf 'vless://%s@%s:443?encryption=none&security=tls&sni=%s&alpn=h3&fp=chrome&type=xhttp&path=%s&mode=auto&host=%s#%s-xhttp-h3\n' \
        "$_uuid_x" "$_dom" "$_dom" "$_path_x" "$_dom" "$_name"
    else
      printf 'vless://%s@%s:%s?encryption=none&type=xhttp&security=none&path=%s&mode=auto#%s-xhttp\n' \
        "$_uuid_x" "$_iph" "$_port_x" "$_path_x" "$_name"
    fi
  fi

  _fam_list=
  case "$_ip" in *:*) _fam_list="v6 $_ip" ;; *) _fam_list="v4 $_ip" ;; esac
  if [ -n "${PUBLIC_IP6:-}" ] && [ "$PUBLIC_IP6" != "$_ip" ]; then
    case "$_ip" in *:*) : ;; *) _fam_list="$_fam_list v6 $PUBLIC_IP6" ;; esac
  fi

  set -- $_fam_list
  while [ $# -ge 2 ]; do
    _fam=$1
    _addr=$2
    _ah=$(_bracket "$_addr")
    shift 2
    if [ -n "$_uuid_r" ]; then
      printf 'vless://%s@%s:%s?encryption=none&flow=xtls-rprx-vision&security=reality&sni=%s&fp=chrome&pbk=%s&sid=%s&type=tcp#%s-%s-reality\n' \
        "$_uuid_r" "$_ah" "$_port_r" "${_sni_r:-$DEF_REALITY_SNI}" "$_pub_r" "$_sid_r" "$_name" "$_fam"
    fi
    [ -n "$_auth_h" ] || continue
    if _cert_is_public; then
      printf 'hysteria2://%s@%s:%s/?sni=%s#%s-%s-hy2\n' "$_auth_h" "$_ah" "$_port_h" "$_ip" "$_name" "$_fam"
    elif _pin=$(_cert_pin_hex); then
      # 自签：SNI 用伪装域名，信任锚是证书指纹（不做 insecure 跳过校验）
      printf 'hysteria2://%s@%s:%s/?sni=%s&pinSHA256=%s#%s-%s-hy2\n' \
        "$_auth_h" "$_ah" "$_port_h" "$(hy2_domain)" "$_pin" "$_name" "$_fam"
    else
      printf 'hysteria2://%s@%s:%s/?sni=%s&insecure=1#%s-%s-hy2\n' "$_auth_h" "$_ah" "$_port_h" "$_ip" "$_name" "$_fam"
    fi
  done
}

# ---------- WARP（Cloudflare，可用作 BT 等流量的出口） ----------
_has_cap_net_admin() { # 读 /proc/self/status 的 CapEff，CAP_NET_ADMIN = bit 12（从右第 4 个 hex 位）
  [ -r /proc/self/status ] || return 1
  _cap=$(sed -n 's/^CapEff:[[:space:]]*//p' /proc/self/status | head -1)
  [ -n "$_cap" ] || return 1
  _nib=$(printf '%s' "$_cap" | sed 's/.*\(.\)....$/\1/')
  case "$_nib" in [13579bdfBDF]) return 0 ;; *) return 1 ;; esac
}

detect_tun_mode() { # 内核 TUN 更快；不可用则回落内置 TCP/IP 栈
  case "$(uname -s)" in Linux) ;; *) printf 'builtin'; return 0 ;; esac
  if [ ! -c /dev/net/tun ]; then
    if ! command_exists modprobe || ! modprobe tun >/dev/null 2>&1; then :; fi
    if [ ! -c /dev/net/tun ] && command_exists mknod; then
      mkdir -p /dev/net 2>/dev/null || true
      mknod /dev/net/tun c 10 200 2>/dev/null || true
    fi
  fi
  [ -c /dev/net/tun ] || { printf 'builtin'; return 0; }
  # 能打开才算可用（容器里可能只是有个空节点）
  ( exec 3<>/dev/net/tun ) 2>/dev/null || { printf 'builtin'; return 0; }
  _has_cap_net_admin || { printf 'builtin'; return 0; }
  printf 'kernel'
}


warp_outbounds() { # 输出 wireguard 出站 + freedom(dialerProxy) 包装
  _builtin=1
  [ "${WARP_TUN_MODE:-builtin}" = kernel ] && _builtin=0
  jq -nc --slurpfile w "$WARP_FILE" --argjson builtin "$_builtin" --arg endpoint "$DEF_WARP_ENDPOINT" --arg warpdial "${WARP_DIAL:-ForceIPv4}" '
    ($w[0]) as $w |
    [
      {tag: "x-warp", protocol: "wireguard", settings: {
        secretKey: $w.privateKey,
        address: $w.addresses,
        peers: [{publicKey: $w.peerPublicKey, endpoint: $endpoint, allowedIPs: ["0.0.0.0/0", "::/0"]}],
        reserved: $w.reserved,
        mtu: ($w.mtu // 1280),
        noKernelTun: ($builtin != 0)  # 有 TUN 权限走内核 TUN（更快），否则内置栈
      },
       # WARP 端点也是域名：让它的解析走 Xray 内置 DNS（DoH），不依赖系统 DNS
       streamSettings: {sockopt: {domainStrategy: $warpdial}}},
      {tag: "warp", protocol: "freedom", settings: {domainStrategy: $warpdial},
       streamSettings: {sockopt: {dialerProxy: "x-warp"}}}
    ]' 2>/dev/null
}

warp_rules() { # 输出路由规则（仅 WARP 开启时）
  case "${WARP_ROUTE:-bittorrent}" in
    bittorrent) printf '[{"type":"field","protocol":["bittorrent"],"outboundTag":"warp"}]' ;;
    all) printf '[{"type":"field","network":"tcp,udp","outboundTag":"warp"}]' ;;
    *) printf '[]' ;;
  esac
}

warp_register() { # 向 Cloudflare 注册免费 WARP 账号，写 $WARP_FILE（600）
  command_exists jq || die "WARP 注册需要 jq"
  log_info "注册 Cloudflare WARP 账号…"
  _k=$("$(_xray)" wg)
  _priv=$(printf '%s\n' "$_k" | sed -n 's/^PrivateKey: //p')
  _pub=$(printf '%s\n' "$_k" | sed -n 's/^Password (PublicKey): //p')
  [ -n "$_priv" ] && [ -n "$_pub" ] || die "WARP 密钥生成失败"
  _tos=$(date -u +%Y-%m-%dT%H:%M:%S.000Z)
  _resp=$(curl -s -m 30 -X POST 'https://api.cloudflareclient.com/v0a2158/reg' \
    -H 'CF-Client-Version: a-7.21-0721' -H 'Content-Type: application/json' \
    -d "{\"key\":\"$_pub\",\"tos\":\"$_tos\"}") || die "WARP 注册请求失败"
  _peer=$(printf '%s' "$_resp" | jq -r '.config.peers[0].public_key // empty')
  _v4=$(printf '%s' "$_resp" | jq -r '.config.interface.addresses.v4 // empty')
  _v6=$(printf '%s' "$_resp" | jq -r '.config.interface.addresses.v6 // empty')
  _cid=$(printf '%s' "$_resp" | jq -r '.config.client_id // empty')
  [ -n "$_peer" ] && [ -n "$_v4" ] || die "WARP 注册返回异常：$(printf '%s' "$_resp" | head -c 200)"
  # reserved = base64(client_id) 的前 3 字节
  _resv=$(printf '%s' "$_cid" | base64 -d 2>/dev/null | od -An -tu1 | tr -s ' ' | sed 's/^ //' | awk '{printf "[%s,%s,%s]", $1,$2,$3}')
  [ -n "$_resv" ] || _resv='[0,0,0]'
  mkdir -p "$STACK_DIR"
  jq -n --arg priv "$_priv" --arg pub "$_peer" --arg v4 "$_v4/32" --arg v6 "${_v6:-}/128" --argjson res "$_resv" '
    {privateKey: $priv, peerPublicKey: $pub,
     addresses: ([$v4] + (if $v6 == "/128" then [] else [$v6] end)), reserved: $res, mtu: 1280,
     registeredAt: (now | todate)}' >"$WARP_FILE.tmp"
  chmod 600 "$WARP_FILE.tmp"
  mv "$WARP_FILE.tmp" "$WARP_FILE"
  log_info "WARP 凭据已保存: $WARP_FILE（出口 $(printf '%s' "$_v4")）"
}

ensure_warp() { # WARP=yes 时：复用或注册凭据
  [ "${WARP:-no}" = yes ] || return 0
  if [ -s "$WARP_FILE" ] && jq -e '.privateKey and .peerPublicKey' "$WARP_FILE" >/dev/null 2>&1; then
    log_info "复用已有 WARP 凭据: $WARP_FILE"
    chmod 600 "$WARP_FILE" 2>/dev/null || true
    return 0
  fi
  warp_register
}

# ---------- 服务托管 ----------
detect_init() {
  if [ -n "${INIT_SYS_OVERRIDE:-}" ]; then
    INIT_SYS=$INIT_SYS_OVERRIDE
    return 0
  fi
  [ -n "${INIT_SYS:-}" ] && return 0 # 已由环境指定（测试/手工覆盖）时不再覆盖
  if [ -d /run/systemd/system ] && command_exists systemctl; then
    INIT_SYS=systemd
  elif command_exists rc-service; then
    INIT_SYS=openrc
  else
    INIT_SYS=none
  fi
}

port_in_use() { # tcp|udp port
  _pu=$1
  _pp=$2
  _hex=$(printf '%04X' "$_pp" 2>/dev/null) || return 1
  case "$_pu" in
    tcp) _files="/proc/net/tcp /proc/net/tcp6" ;;
    udp) _files="/proc/net/udp /proc/net/udp6" ;;
    *) return 1 ;;
  esac
  # TCP 监听是 0A；UDP 未连接套接字是 07（没有 0A）
  _want_st="0A"
  [ "$_pu" = udp ] && _want_st="07|0A"
  for _pf in $_files; do
    [ -r "$_pf" ] || continue
    if awk -v want=":$_hex" -v st="$_want_st" 'BEGIN { n = split(st, s, "|") } NR>1 { split($2, a, ":"); if (":" a[2] == want) { for (i = 1; i <= n; i++) if ($4 == s[i]) f = 1 } } END { exit f ? 0 : 1 }' "$_pf"; then
      return 0
    fi
  done
  return 1
}

_svc_body_systemd() { # name cmd
  {
    printf '[Unit]\nDescription=okxhttp %s\nAfter=network-online.target\nWants=network-online.target\n\n' "$1"
    printf '[Service]\nType=simple\nExecStart=%s\nRestart=always\nRestartSec=5\nLimitNOFILE=1048576\n' "$2"
    [ -n "${SVC_LOG:-}" ] && printf 'StandardOutput=append:%s\nStandardError=append:%s\n' "$SVC_LOG" "$SVC_LOG"
    printf '\n[Install]\nWantedBy=multi-user.target\n'
  }
}

_svc_body_openrc() { # name cmdline —— 有 supervise-daemon 时用守护模式（进程退出自动拉起）
  _oname=$1
  _ocmd=$2
  # shellcheck disable=SC2086
  set -- $_ocmd
  _obin=$1
  shift
  _oargs=
  for _a in "$@"; do _oargs="$_oargs $_a"; done
  {
    printf '#!/sbin/openrc-run\n'
    printf 'description="okxhttp %s"\n' "$_oname"
    printf 'supervisor="supervise-daemon"\n'
    printf 'respawn_delay=5\nrespawn_max=0\n' # 5s 后拉起，不设次数上限
    printf 'command="%s"\n' "$_obin"
    printf 'command_args="%s"\n' "${_oargs# }"
    [ -n "${SVC_LOG:-}" ] && printf 'output_log="%s"\nerror_log="%s"\n' "$SVC_LOG" "$SVC_LOG"
    printf 'depend() {\n\tneed net\n\tafter firewall\n}\n'
  }
}

svc_install() { # name cmdline（cmdline 内不能含空格参数，token/path 均满足）
  _sname=$1
  shift
  _cmd=$*
  [ -n "$_cmd" ] || die "svc_install 需要可执行命令"
  case "${INIT_SYS:-none}" in
    systemd)
      _svc_body_systemd "$_sname" "$_cmd" >"/etc/systemd/system/$_sname.service"
      chmod 600 "/etc/systemd/system/$_sname.service" # 固定隧道 token 在 ExecStart 里
      systemctl daemon-reload >/dev/null 2>&1 || true
      systemctl enable "$_sname" >/dev/null 2>&1 || true
      systemctl restart "$_sname" >/dev/null 2>&1 || log_warn "$_sname 启动失败（journalctl -u $_sname 查看）"
      ;;
    openrc)
      _svc_body_openrc "$_sname" "$_cmd" >"/etc/init.d/$_sname"
      chmod 700 "/etc/init.d/$_sname" # 可能含 token，仅 root
      rc-update add "$_sname" default >/dev/null 2>&1 || true
      rc-service "$_sname" restart >/dev/null 2>&1 || rc-service "$_sname" start >/dev/null 2>&1 || log_warn "$_sname 启动失败（rc-service $_sname status 查看）"
      ;;
    fake)
      mkdir -p "${FAKE_INIT_DIR:?FAKE_INIT_DIR 未设置}"
      _svc_body_systemd "$_sname" "$_cmd" >"$FAKE_INIT_DIR/$_sname.service"
      ;;
    none)
      mkdir -p "$STACK_DIR"
      nohup $_cmd >>"${SVC_LOG:-/dev/null}" 2>&1 &
      printf '%s\n' "$!" >"$STACK_DIR/$_sname.pid"
      ;;
  esac
}

svc_stop() {
  case "${INIT_SYS:-none}" in
    systemd) systemctl stop "$1" >/dev/null 2>&1 || true ;;
    openrc) rc-service "$1" stop >/dev/null 2>&1 || true ;;
    fake | none)
      if [ -f "$STACK_DIR/$1.pid" ]; then
        kill "$(cat "$STACK_DIR/$1.pid")" 2>/dev/null || true
        rm -f "$STACK_DIR/$1.pid"
      fi
      ;;
  esac
}

svc_running() {
  case "${INIT_SYS:-none}" in
    systemd) systemctl is-active --quiet "$1" 2>/dev/null ;;
    openrc) rc-service "$1" status >/dev/null 2>&1 ;;
    fake | none)
      [ -f "$STACK_DIR/$1.pid" ] || return 1
      kill -0 "$(cat "$STACK_DIR/$1.pid")" 2>/dev/null
      ;;
  esac
}

svc_remove() {
  svc_stop "$1"
  case "${INIT_SYS:-none}" in
    systemd)
      systemctl disable "$1" >/dev/null 2>&1 || true
      rm -f "/etc/systemd/system/$1.service"
      systemctl daemon-reload >/dev/null 2>&1 || true
      ;;
    openrc)
      rc-update del "$1" default >/dev/null 2>&1 || true
      rm -f "/etc/init.d/$1"
      ;;
    fake) rm -f "${FAKE_INIT_DIR:?}/$1.service" ;;
    none) rm -f "$STACK_DIR/$1.pid" ;;
  esac
}

_listen_inode() { # tcp|udp port -> socket inode（取自 /proc/net/*）
  _hex=$(printf '%04X' "$2" 2>/dev/null) || return 1
  case "$1" in
    tcp) _fl="/proc/net/tcp /proc/net/tcp6" ;;
    udp) _fl="/proc/net/udp /proc/net/udp6" ;;
    *) return 1 ;;
  esac
  for _f in $_fl; do
    [ -r "$_f" ] || continue
    awk -v want=":$_hex" 'NR>1 { split($2, a, ":"); if (":" a[2] == want && ($4 == "0A" || $4 == "07")) { print $10; exit } }' "$_f"
  done
}

_inode_pid() { # inode -> pid（扫 /proc/*/fd）
  for _d in /proc/[0-9]*; do
    for _fd in "$_d"/fd/*; do
      [ -L "$_fd" ] || continue
      if [ "$(readlink "$_fd" 2>/dev/null)" = "socket:[$1]" ]; then
        printf '%s' "${_d#/proc/}"
        return 0
      fi
    done
  done
  return 1
}

_port_owner_is_xray() { # proto port —— 端口是否由我们自己的 xray 持有
  _ino=$(_listen_inode "$1" "$2")
  [ -n "${_ino:-}" ] || return 1
  _opid=$(_inode_pid "$_ino") || return 1
  _oexe=$(readlink "/proc/$_opid/exe" 2>/dev/null || true)
  [ "$_oexe" = "$XRAY_BIN" ] && return 0
  tr '\000' ' ' <"/proc/$_opid/cmdline" 2>/dev/null | grep -q -- "$CONFIG" && return 0
  return 1
}

_port_blocked() { # proto port —— 被"非本服务"占用才返回 0
  port_in_use "$1" "$2" || return 1
  if _port_owner_is_xray "$1" "$2"; then
    log_info "端口 $2/$1 由本服务占用（重装会重启它）"
    return 1
  fi
  _who=$(_inode_pid "$(_listen_inode "$1" "$2")" 2>/dev/null || true)
  [ -n "${_who:-}" ] && log_warn "端口 $2/$1 被 PID $_who 占用：$(tr '\000' ' ' <"/proc/$_who/cmdline" 2>/dev/null | cut -c1-60)"
  return 0
}

_expected_ports() { # 从 config 推导"应该处于 LISTEN"的端口
  jq -r '.inbounds[] | "\(.port) \(if .streamSettings.network=="hysteria" then "udp" else "tcp" end)"' "$CONFIG" 2>/dev/null
}

wait_serving() { # timeout —— 真实端口起来才算服务可用
  [ -n "$(_expected_ports)" ] || return 1
  _i=0
  while [ "$_i" -lt "${1:-10}" ]; do
    _all=1
    _expected_ports | while read -r _pp _pu; do
      port_in_use "$_pu" "$_pp" || exit 1
    done || _all=0
    [ "$_all" = 1 ] && return 0
    sleep 1
    _i=$((_i + 1))
  done
  return 1
}

preflight() { # 只做校验，不动运行中的服务
  detect_init
  [ -e /proc/net/if_inet6 ] || log_warn "本机没有 IPv6，入站监听 :: / ::1 会失败（需要内核开启 IPv6）"
  _proto_each _preflight_port
  if [ "${ENABLE_REALITY:-0}" = 1 ] && ! check_reality_dest "${REALITY_SNI:-$DEF_REALITY_SNI}"; then
    log_warn "REALITY 目标 ${REALITY_SNI} 未通过 TLS1.3+h2 探测，可能握手失败（可换 REALITY_SNI）"
  fi
}

_preflight_port() { # tag port net
  _port_blocked "$3" "$2" &&
    die "端口 $2/$3 已被其他进程占用（用 $(_lbl "$1" | tr '[:lower:]' '[:upper:]')_PORT 换一个）"
  return 0
}

# ---------- 配置采集与状态 ----------
usage() {
  cat <<'EOF'
okxhttp —— Xray 多协议一键部署（VLESS-XHTTP+Argo / VLESS-TCP-REALITY-Vision / Hysteria2）

用法: okxhttp [选项]
  （无参数）      安装/重装，之后每次运行都先打印状态与操作列表
  --status        打印部署状态
  --info          打印节点链接（按当前 config.json 实时推导）
  --restart       重启 xray 与 argo
  --log[=xray|argo]  看日志（LOG_LINES 控制行数，默认 50）
  --cert-info     证书信息（签发者/有效期/SAN/指纹）
  --renew         立即续期（仅 HY2_CERT=le）
  --sub-reset     重置订阅 key（清空旧内容 → 生成新 key → 推送）
  --uninstall     卸载，保留证书目录
  --purge         卸载并删除证书
  --version|--help

用环境变量做非交互安装（YES=1）：
  XHTTP/REALITY/HY2=yes|no          协议开关（默认全开）
  ARGO_MODE=temp|token|off          隧道模式（默认 temp）
  ARGO_AUTH / ARGO_DOMAIN           固定隧道的 token / 域名
  XHTTP_PORT / REALITY_PORT / HY2_PORT   端口（默认 2087 / 443 / 443）
  REALITY_SNI=<host>                REALITY 伪装域名（默认 pic.bstarstatic.com）
  HY2_CERT=self|le  LE_EMAIL=<邮箱>   hy2 证书
  WARP=yes|no  WARP_ROUTE=bittorrent|all
  SUB=yes|no  SUB_URL=<url>         订阅（默认 yes + AnyNote）
  DNS_DOH=yes|no                    用 Xray 内置 DoH（默认 yes）
  NODE_NAME / PUBLIC_IP / PUBLIC_IP6 节点名 / 公网 IP（v6 会自动探测，直连协议同时出 v4/v6 链接）
  TEMP_TRANSPORT=ws|xhttp           临时隧道传输（默认 ws）
  YES=1                             非交互
EOF
}

MODE=
parse_args() {
  for _arg in "$@"; do
    case "$_arg" in
      --yes | -y) YES=1 ;;
      --info) MODE=info ;;
      --status) MODE=status ;;
      --restart) MODE=restart ;;
      --log) MODE=log ;;
      --log=*) MODE=log; LOG_TARGET=${_arg#--log=} ;;
      --renew) MODE=renew ;;
      --subsync) MODE=subsync ;;
      --daemon) MODE=daemon ;;
      --sub-reset) MODE=subreset ;;
      --cert-info) MODE=certinfo ;;
      --uninstall) MODE=uninstall ;;
      --purge) MODE=uninstall; PURGE=1 ;;
      --version | -V) printf 'okxhttp %s\n' "$SCRIPT_VERSION"; exit 0 ;;
      --help | -h) usage; exit 0 ;;
      *) die "未知参数: $_arg（--help 查看用法）" ;;
    esac
  done
}

_STATE_KEYS=" "

hydrate_from_config() { # 已部署配置是事实源：覆盖那些"不是用户用环境变量显式指定"的派生值
  [ -s "$CONFIG" ] || return 0
  _kv=$(jq -r --arg tx "$TAG_XHTTP" --arg tw "$TAG_WS" --arg tr "$TAG_REALITY" --arg th "$TAG_HY2" '
    [.inbounds[]|select(.tag==$tx)] as $xs | ($xs[0]//{}) as $x |
    [.inbounds[]|select(.tag==$tw)] as $ws | ($ws[0]//{}) as $w |
    [.inbounds[]|select(.tag==$tr)] as $rs | ($rs[0]//{}) as $r |
    [.inbounds[]|select(.tag==$th)] as $hs | ($hs[0]//{}) as $h |
    [
      {k:"ENABLE_XHTTP",    v:(if (($x|length)>0 or ($w|length)>0) then "1" else "0" end)},
      {k:"ENABLE_WS",       v:(if ($w|length)>0 then "1" else "0" end)},
      {k:"ENABLE_REALITY",  v:(if ($r|length)>0 then "1" else "0" end)},
      {k:"ENABLE_HY2",      v:(if ($h|length)>0 then "1" else "0" end)},
      {k:"XHTTP_PORT",      v:($x.port//""|tostring)},
      {k:"XHTTP_PATH",      v:($x.streamSettings.xhttpSettings.path//"")},
      {k:"XHTTP_LISTEN",    v:($x.listen//"")},
      {k:"WS_PORT",         v:($w.port//""|tostring)},
      {k:"WS_PATH",         v:($w.streamSettings.wsSettings.path//"")},
      {k:"REALITY_PORT",    v:($r.port//""|tostring)},
      {k:"REALITY_SNI",     v:($r.streamSettings.realitySettings.serverNames[0]//"")},
      {k:"REALITY_SHORTID", v:($r.streamSettings.realitySettings.shortIds[0]//"")},
      {k:"HY2_PORT",        v:($h.port//""|tostring)},
      {k:"UUID",            v:($x.settings.clients[0].id // $w.settings.clients[0].id // $r.settings.clients[0].id // "")}
    ] | .[] | select(.v != "") | "\(.k)=\(.v)"' "$CONFIG" 2>/dev/null || true)
  [ -n "$_kv" ] || return 0
  while IFS='=' read -r _k _v; do
    [ -n "$_k" ] || continue
    case " $_STATE_KEYS " in
      *" $_k "*) eval "export $_k=\$_v" ;;                 # 来自状态文件 → 以配置为准
      *) eval "_cur=\${$_k:-}"; [ -n "$_cur" ] || eval "export $_k=\$_v" ;; # 未提供 → 填上
    esac
  done <<EOF
$_kv
EOF
  # 临时隧道用 WS 暴露：xhttp 入站不算"在用"（旧配置可能还留着它）
  if [ "${ARGO_MODE:-}" = temp ] && [ "${TEMP_TRANSPORT:-ws}" = ws ] && [ "${ENABLE_WS:-0}" = 1 ]; then
    EXPOSE_WS=1
    export EXPOSE_WS
  fi
  # 明文监听公网 == 不走隧道
  if [ -n "${XHTTP_LISTEN:-}" ] && ! _is_loopback "$XHTTP_LISTEN"; then
    case " $_STATE_KEYS " in
      *" ARGO_MODE "*) : ;;
      *) [ -n "${ARGO_MODE:-}" ] || ARGO_MODE=off ;;
    esac
    if [ -n "${ARGO_MODE:-}" ] && [ "$ARGO_MODE" != off ]; then ARGO_MODE=off; fi
  fi
  return 0
}

load_state() {
  _STATE_KEYS=" "
  if [ -f "$STATE" ]; then
    _tmp="$STATE.parsed"
    grep -E '^[A-Z0-9_]+=' "$STATE" >"$_tmp" 2>/dev/null || : >"$_tmp"
    while IFS='=' read -r _k _v; do
      case "$_k" in
        '' | *[!A-Z0-9_]*) continue ;;
      esac
      eval "_cur=\${$_k:-}"
      if [ -z "$_cur" ]; then
        eval "export $_k=\$_v"
        _STATE_KEYS="$_STATE_KEYS$_k "
      fi
    done <"$_tmp"
    rm -f "$_tmp"
  fi
  hydrate_from_config
}

save_state() {
  mkdir -p "$STACK_DIR"
  _keys=
  # shellcheck disable=SC2086
  set -- $PROTO_SPECS
  while [ $# -ge 6 ]; do
    _keys="$_keys $2 $3"
    shift 6
  done
  _keys="$_keys ARGO_MODE ARGO_DOMAIN ARGO_AUTH ARGO_PROTO_USED ARGO_EDGE_MODE TEMP_TRANSPORT
    XHTTP_PATH WS_PATH REALITY_SNI REALITY_PUB REALITY_SHORTID HY2_CERT HY2_CERT_EFFECTIVE HY2_BRUTAL_UP HY2_BRUTAL_DOWN LE_EMAIL
    NODE_NAME PUBLIC_IP PUBLIC_IP6 UUID WARP WARP_ROUTE WARP_TUN_MODE DNS_DOH SUB_KEY SUB_LAST"
  {
    for _k in $_keys; do
      eval "_v=\${$_k:-}"
      [ -n "$_v" ] && printf '%s=%s\n' "$_k" "$_v"
    done
  } >"$STATE.tmp"
  chmod 600 "$STATE.tmp"
  mv "$STATE.tmp" "$STATE"
}

_yesno() { # 值 → 1/0，非法值返回 2
  case "$1" in
    yes | y | 1 | true) echo 1 ;;
    no | n | 0 | false) echo 0 ;;
    *) return 2 ;;
  esac
}

_collect_tcp_port() { # tag port net
  [ "$3" = tcp ] && _tcp_ports="$_tcp_ports $2"
  return 0
}

_apply_proto_env() { # --yes：协议开关取"环境变量 > 已部署状态 > 默认开"
  # shellcheck disable=SC2086
  set -- $PROTO_SPECS
  while [ $# -ge 6 ]; do
    _ap_tag=$1 _ap_var=$2 _ap_env=$5
    shift 6
    [ "$_ap_env" = "-" ] && continue
    eval "_ap_raw=\${_ENV_${_ap_env}:-}"
    [ -n "$_ap_raw" ] || eval "_ap_raw=\${$_ap_env:-}"
    if [ -n "$_ap_raw" ]; then
      _ap_val=$(_yesno "$_ap_raw") || die "$_ap_env 只能是 yes/no"
      eval "$_ap_var=\$_ap_val"
    else
      eval "_ap_val=\${$_ap_var:-1}"
    fi
    eval "export $_ap_var"
  done
}

collect_config() {
  detect_os
  detect_init
  # 以已部署配置为起点（端口/路径/协议开关），环境变量仍优先
  hydrate_from_config
  NODE_NAME=${NODE_NAME:-$(hostname 2>/dev/null || echo node)}
  if [ "${YES:-0}" = 1 ]; then
    _apply_proto_env
  else
    [ -t 0 ] || die "当前不是交互终端：请加 --yes 并用环境变量指定协议"
    _menu_toggle
  fi
  [ -n "$(_proto_list)" ] || die "至少要启用一个协议"

  ARGO_MODE=${ARGO_MODE:-temp}
  case "$ARGO_MODE" in temp | token | off) ;; *) die "ARGO_MODE 只能是 temp/token/off" ;; esac
  ARGO_PROTO=${ARGO_PROTO:-auto}
  case "$ARGO_PROTO" in auto | quic | http2) ;; *) die "ARGO_PROTO 只能是 auto/quic/http2" ;; esac
  if [ "$ENABLE_XHTTP" = 1 ] && [ "$ARGO_MODE" = token ]; then
    [ -n "${ARGO_AUTH:-}" ] || die "ARGO_MODE=token 需要 ARGO_AUTH"
    [ -n "${ARGO_DOMAIN:-}" ] || die "ARGO_MODE=token 需要 ARGO_DOMAIN"
  fi

  SUB=${SUB:-yes}
  case "$SUB" in yes | no) ;; *) die "SUB 只能是 yes/no" ;; esac

  DNS_DOH=${DNS_DOH:-yes}
  case "$DNS_DOH" in yes | no) ;; *) die "DNS_DOH 只能是 yes/no" ;; esac

  WARP=${WARP:-no}
  case "$WARP" in yes | no) ;; *) die "WARP 只能是 yes/no" ;; esac
  WARP_ROUTE=${WARP_ROUTE:-bittorrent}
  case "$WARP_ROUTE" in bittorrent | all) ;; *) die "WARP_ROUTE 只能是 bittorrent/all" ;; esac

  HY2_CERT=${HY2_CERT:-self}
  case "$HY2_CERT" in self | le) ;; *) die "HY2_CERT 只能是 self/le" ;; esac
  if [ -n "${HY2_BRUTAL_UP:-}${HY2_BRUTAL_DOWN:-}" ]; then
    _set_brutal "${HY2_BRUTAL_UP:-${HY2_BRUTAL_DOWN}}/${HY2_BRUTAL_DOWN:-${HY2_BRUTAL_UP}}" ||
      die "HY2_BRUTAL_UP/HY2_BRUTAL_DOWN 必须是正整数（Mbps）"
  fi
  LE_EMAIL=${LE_EMAIL:-$DEF_LE_EMAIL}

  REALITY_SNI=${REALITY_SNI:-$DEF_REALITY_SNI}
  if [ -n "${_ENV_PORTS_SNAPSHOTTED:-}" ]; then
    _xhttp_port_given=$_ENV_XHTTP_PORT
    _ws_port_given=$_ENV_WS_PORT
  else
    _xhttp_port_given=${XHTTP_PORT:-}
    _ws_port_given=${WS_PORT:-}
  fi
  XHTTP_PORT=${XHTTP_PORT:-$DEF_XHTTP_PORT}
  REALITY_PORT=${REALITY_PORT:-$DEF_REALITY_PORT}
  HY2_PORT=${HY2_PORT:-$DEF_HY2_PORT}
  XHTTP_PATH=${XHTTP_PATH:-/$(rand_hex 6)}
  WS_PATH=${WS_PATH:-/$(rand_hex 6)}
  TEMP_TRANSPORT=${TEMP_TRANSPORT:-ws}
  case "$TEMP_TRANSPORT" in xhttp | ws) ;; *) die "TEMP_TRANSPORT 只能是 xhttp/ws" ;; esac
  # 临时隧道 + WS 暴露时不需要 xhttp 入站（quick tunnel 承载不了 XHTTP）
  if [ "$ENABLE_XHTTP" = 1 ] && [ "$ARGO_MODE" = temp ] && [ "$TEMP_TRANSPORT" = ws ]; then
    EXPOSE_WS=1
    ENABLE_WS=1
  else
    EXPOSE_WS=0
    ENABLE_WS=0
  fi
  if [ "$ARGO_MODE" = temp ] && [ "$EXPOSE_WS" = 0 ]; then
    # 临时隧道的本地端口默认随机高位：避免固定端口撞车，也少一点特征
    if [ -z "$_xhttp_port_given" ] && ! _has_inbound "$TAG_XHTTP"; then
      XHTTP_PORT=$(_pick_free_port "$REALITY_PORT" "$HY2_PORT")
      log_info "临时隧道使用随机端口: xhttp=$XHTTP_PORT"
    fi
  fi
  # WS 端口默认在 XHTTP_PORT 确定之后再算，保证随机化后仍不撞车
  WS_PORT=${WS_PORT:-$((XHTTP_PORT + 1))}
  if [ "$EXPOSE_WS" = 1 ] && [ -z "$_ws_port_given" ] && ! _has_inbound "$TAG_WS"; then
    WS_PORT=$(_pick_free_port "$XHTTP_PORT" "$REALITY_PORT" "$HY2_PORT")
    log_info "临时隧道使用随机端口: ws=$WS_PORT"
  fi
  _tcp_ports=
  _proto_each _collect_tcp_port
  _dup=$(printf '%s\n' $_tcp_ports | sed '/^$/d' | sort | uniq -d | head -1)
  [ -z "$_dup" ] || die "端口 $_dup/tcp 重复：同一协议族不能同号"
  export ENABLE_XHTTP ENABLE_REALITY ENABLE_HY2 ARGO_MODE ARGO_PROTO HY2_CERT LE_EMAIL WARP WARP_ROUTE DNS_DOH SUB
  export EXPOSE_WS REALITY_SNI XHTTP_PORT REALITY_PORT HY2_PORT XHTTP_PATH NODE_NAME PUBLIC_IP6
  export WS_PORT WS_PATH ENABLE_WS TEMP_TRANSPORT
}

_menu_toggle() {
  # 起点沿用已部署的选择（首次安装时为空 → 默认全开）
  _toggling=$(_toggle_vars)
  for _v in $_toggling; do
    eval "_cur=\${$_v:-1}"
    eval "$_v=\$_cur"
  done
  while :; do
    printf '\n当前选择：\n'
    _i=0
    for _v in $_toggling; do
      _i=$((_i + 1))
      _on=
      eval "_on=\${$_v:-1}"
      printf '  %d) %s: %s\n' "$_i" "$(_tag_of_var "$_v")" "$([ "$_on" = 1 ] && echo 启用 || echo 关闭)"
    done
    printf '输入 1-%d 切换，a 全选，n 全不选，回车确认：' "$_i"
    read -r _ans || _ans=
    case "$_ans" in
      a | A | n | N)
        _set=1
        [ "$_ans" = n ] || [ "$_ans" = N ] && _set=0
        for _v in $_toggling; do
          eval "$_v=$_set"
          eval "export $_v"
        done
        ;;
      '') break ;;
      *[!0-9]*) log_warn "不认识的输入: $_ans" ;;
      *)
        _i=0
        for _v in $_toggling; do
          _i=$((_i + 1))
          [ "$_i" = "$_ans" ] || continue
          eval "_on=\${$_v:-1}"
          _on=
          eval "_on=\${$_v:-1}"
          [ "$_on" = 1 ] && eval "$_v=0" || eval "$_v=1"
          eval "export $_v"
        done
        ;;
    esac
  done
  if [ "$ENABLE_XHTTP" = 1 ]; then
    printf 'Argo 模式：1=临时隧道 2=固定隧道(token) 3=不用隧道[1]：'
    read -r _ans || _ans=
    case "$_ans" in
      2)
        ARGO_MODE=token
        printf 'ARGO_DOMAIN%s：' "$([ -n "${ARGO_DOMAIN:-}" ] && printf ' [%s]（回车保持）' "$ARGO_DOMAIN")"
        read -r _a || _a=
        [ -n "$_a" ] && ARGO_DOMAIN=$_a
        printf 'ARGO_AUTH(token)%s：' "$([ -n "${ARGO_AUTH:-}" ] && printf ' [已保存，回车保持]')"
        read -r _a || _a=
        [ -n "$_a" ] && ARGO_AUTH=$_a
        ;;
      3) ARGO_MODE=off ;;
      *) ARGO_MODE=temp ;;
    esac
  fi
  if [ "$ENABLE_HY2" = 1 ]; then
    printf 'Hysteria2 证书：1=自签 2=真实 IP 证书(LE)[1]：'
    read -r _ans || _ans=
    case "$_ans" in 2) HY2_CERT=le ;; *) HY2_CERT=self ;; esac
    _ask_brutal
  fi
  _DIRECT_ONLY=1 _proto_each _ask_port
  _ask_node_name
  _wdef=1
  if [ "${WARP:-no}" = yes ]; then
    [ "${WARP_ROUTE:-bittorrent}" = all ] && _wdef=3 || _wdef=2
  fi
  printf 'Cloudflare WARP 出站：1=不启用 2=仅 BT 走 WARP 3=全部流量走 WARP[%s]：' "$_wdef"
  read -r _ans || _ans=
  case "${_ans:-$_wdef}" in
    1) WARP=no; WARP_ROUTE='' ;;
    2) WARP=yes; WARP_ROUTE=bittorrent ;;
    3) WARP=yes; WARP_ROUTE=all ;;
  esac
}

# ---------- 订阅（AnyNote：POST /set 写入，GET /<key> 读取） ----------
_sub_post() { # key value —— 唯一的网络写入点（测试可覆盖）
  jq -nc --arg k "$1" --arg v "$2" '{key: $k, value: $v}' \
    | curl -fsS -m 20 -X POST "${SUB_URL}/set" -H 'Content-Type: application/json' --data-binary @- >/dev/null
}

sub_links() { # 订阅内容 = 当前节点链接（纯文本，客户端可直接导入）
  gen_links | grep -E '://'
}

_sub_hash() { printf '%s' "$1" | sha256sum | cut -d' ' -f1; }

sub_push() { # 生成当前内容并推送
  [ -n "${SUB_KEY:-}" ] || return 1
  _val=$(sub_links) || return 1
  [ -n "$_val" ] || return 1
  _sub_post "$SUB_KEY" "$_val" || {
    log_warn "订阅推送失败（$SUB_URL）"
    return 1
  }
  SUB_LAST=$(_sub_hash "$_val")
  save_state
}

_fill_public_ip6() { # 只在 PUBLIC_IP6 缺失时探测一次，补上就落状态
  [ -z "${PUBLIC_IP6:-}" ] || return 0
  _PROBED='' PROBE_IP_V4='' PROBE_IP_V6=''
  _probe_all
  [ -n "${PROBE_IP_V6:-}" ] || return 0
  [ "${PROBE_IP_V6}" = "${PUBLIC_IP:-}" ] && return 0
  PUBLIC_IP6=$PROBE_IP_V6
  export PUBLIC_IP6
  save_state
}

refresh_public_ips() { # 重新探测公网 IP（跟随订阅检查一起做）；有变化写回状态并返回 0
  _PROBED='' PROBE_IP_V4='' PROBE_IP_V6=''
  _probe_all
  [ -n "${PROBE_IP_V4:-}${PROBE_IP_V6:-}" ] || return 1 # 探测失败：保持现状
  if [ "${PROBE_IP_V4:-}" = "${PUBLIC_IP:-}" ] && [ "${PROBE_IP_V6:-}" = "${PUBLIC_IP6:-}" ]; then
    return 1
  fi
  if [ -n "${PROBE_IP_V4:-}" ]; then
    PUBLIC_IP=$PROBE_IP_V4
  elif [ -n "${PROBE_IP_V6:-}" ]; then
    PUBLIC_IP=$PROBE_IP_V6
  fi
  PUBLIC_IP6=${PROBE_IP_V6:-}
  export PUBLIC_IP PUBLIC_IP6
  save_state
  log_info "公网 IP 变更：${PUBLIC_IP}${PUBLIC_IP6:+/$PUBLIC_IP6}"
}

sub_sync() { # 调度服务调用：先刷新公网 IP，内容有变化才推
  load_state
  refresh_public_ips >/dev/null 2>&1 || true
  [ "${SUB:-yes}" = yes ] || return 0
  [ -n "${SUB_KEY:-}" ] || return 0
  _val=$(sub_links 2>/dev/null) || return 0
  [ -n "$_val" ] || return 0
  [ "$(_sub_hash "$_val")" = "${SUB_LAST:-}" ] && return 0
  log_info "节点有变化，更新订阅 $SUB_URL/$SUB_KEY"
  sub_push
}

sub_clear() { # 清空当前 key 的内容（重置与卸载共用）
  [ -n "${SUB_KEY:-}" ] || return 0
  log_info "清空订阅内容: $SUB_URL/$SUB_KEY"
  _sub_post "$SUB_KEY" "" || {
    log_warn "订阅内容清理失败（$SUB_URL/$SUB_KEY）"
    return 1
  }
}

sub_reset() { # 重置 key：先清空旧 key 内容，再用新 key 推送
  load_state
  sub_clear || log_warn "旧 key 清理失败（继续用新 key）"
  SUB_KEY=$(gen_uuid)
  SUB_LAST=
  save_state
  sub_push || return 1
  install_sched_service
  log_info "新订阅地址: $SUB_URL/$SUB_KEY"
}

# ---------- 卸载 / 信息 / 安装主流程 ----------
do_uninstall() {
  detect_init
  for _svc in xray argo "$SVC_SCHED"; do
    svc_remove "$_svc" 2>/dev/null || true
  done
  argo_stop 2>/dev/null || true
  _remove_hosts_block
  if [ -f "$STATE" ]; then
    load_state
    sub_clear >/dev/null 2>&1 || true # 卸载也要把订阅内容清掉
  fi
  if [ -f "$STACK_DIR/.installed_bins" ]; then
    while read -r _b; do
      [ -n "$_b" ] && rm -f "$_b"
    done <"$STACK_DIR/.installed_bins"
  fi
  _keep=
  if [ "${PURGE:-0}" != 1 ] && [ -d "$TLS_DIR" ]; then
    _keep="$(dirname "$STACK_DIR")/.xray-stack-keep-certs.$$"
    rm -rf "$_keep"
    mv "$TLS_DIR" "$_keep"
  fi
  rm -rf "$STACK_DIR"
  mkdir -p "$STACK_DIR"
  if [ -n "$_keep" ]; then
    mv "$_keep" "$TLS_DIR"
    log_info "已卸载（证书保留在 $TLS_DIR）"
  elif [ "${PURGE:-0}" = 1 ]; then
    log_info "已卸载（含证书）"
  else
    log_info "已卸载"
  fi
}

do_info() {
  load_state
  printf '\n===== 节点链接（由当前配置生成）=====\n'
  gen_links
  detect_init
  [ -n "${ARGO_PROTO_USED:-}" ] && printf 'Argo 连接器（上次安装实测）: %s\n' "$ARGO_PROTO_USED"
  printf '\n服务状态: xray=%s argo=%s\n' \
    "$(svc_running xray && echo running || echo stopped)" \
    "$(svc_running argo && echo running || echo stopped)"
}

_record_bin() {
  mkdir -p "$STACK_DIR"
  _bins="$STACK_DIR/.installed_bins"
  [ -f "$_bins" ] && grep -qxF "$1" "$_bins" && return 0
  printf '%s\n' "$1" >>"$_bins"
}

_existing_cfg_get() { # jq filter -> 已部署配置里的值（没有则为空）
  [ -s "$CONFIG" ] || return 0
  jq -r "$1 // empty" "$CONFIG" 2>/dev/null || true
}

_ensure_keys() {
  # 凭据以已部署的 config.json 为准：重装绝不能轮换，否则所有客户端失效
  if [ -z "${UUID:-}" ]; then
    UUID=$(_existing_cfg_get '.inbounds[0].settings.clients[0].id')
  fi
  if [ -z "${UUID:-}" ]; then UUID=$(gen_uuid); fi
  if [ "${ENABLE_REALITY:-0}" = 1 ] && [ -z "${REALITY_PRIV:-}" ]; then
    REALITY_PRIV=$(_existing_cfg_get '.inbounds[]|select(.tag=="'"$TAG_REALITY"'")|.streamSettings.realitySettings.privateKey')
  fi
  if [ "${ENABLE_HY2:-0}" = 1 ] && [ -z "${HY2_PASSWORD:-}" ]; then
    HY2_PASSWORD=$(_existing_cfg_get '.inbounds[]|select(.tag=="'"$TAG_HY2"'")|.settings.clients[0].auth')
  fi
  if [ "${ENABLE_REALITY:-0}" = 1 ] && { [ -z "${REALITY_PRIV:-}" ] || [ -z "${REALITY_PUB:-}" ]; }; then
    eval "$(gen_x25519)" || die "REALITY 密钥生成失败"
    REALITY_PRIV=$PRIVATE_KEY
    REALITY_PUB=$PUBLIC_KEY
  fi
  [ -n "${REALITY_SHORTID:-}" ] || REALITY_SHORTID=$(gen_shortid)
  if [ "${ENABLE_HY2:-0}" = 1 ] && [ -z "${HY2_PASSWORD:-}" ]; then HY2_PASSWORD=$(gen_password); fi
  export UUID REALITY_PRIV REALITY_PUB REALITY_SHORTID HY2_PASSWORD
}

_is_le_cert() { # file
  openssl x509 -in "$1" -noout -issuer 2>/dev/null | grep -q "Let's Encrypt"
}

_cert_covers_ip() { # file ip
  openssl x509 -in "$1" -noout -ext subjectAltName 2>/dev/null | grep -q "IP Address:$2"
}

hy2_domain() { # hy2 自签证书用的域名：与 REALITY 伪装域名保持同一个
  printf '%s' "${REALITY_SNI:-$DEF_REALITY_SNI}"
}

_cert_covers_dns() { # file domain
  openssl x509 -in "$1" -noout -ext subjectAltName 2>/dev/null | grep -q "DNS:$2"
}

_ensure_cert() {
  [ "${ENABLE_HY2:-0}" = 1 ] || return 0
  mkdir -p "$TLS_DIR"
  if [ "${HY2_CERT:-self}" = le ]; then
    # 复用仍有效（>2 天）且 SAN 匹配当前 IP 的 LE 证书：重装不应重新签发（LE 有额度限制）
    if [ -s "$TLS_DIR/cert.pem" ] \
      && _is_le_cert "$TLS_DIR/cert.pem" && _cert_covers_ip "$TLS_DIR/cert.pem" "$PUBLIC_IP" \
      && openssl x509 -in "$TLS_DIR/cert.pem" -noout -checkend 172800 >/dev/null 2>&1; then
      HY2_CERT_EFFECTIVE=le
      log_info "复用现有 LE 证书（剩余 >2 天）"
      return 0
    fi
    log_info "用 lego 申请 LE shortlived IP 证书（HTTP-01，需要 80 端口可达）…"
    if _lego_run "$PUBLIC_IP" && _install_le_files "$PUBLIC_IP"; then
      HY2_CERT_EFFECTIVE=le
      log_info "LE 证书签发成功（有效期约 6 天，调度服务每天检查自动续期）"
      return 0
    fi
    log_err "LE 证书签发失败，回退为自签证书（hy2 仍可用，客户端需 pin 或跳过校验）"
    HY2_CERT_EFFECTIVE=self
  else
    HY2_CERT_EFFECTIVE=self
  fi
  _hdom=$(hy2_domain)
  if [ ! -s "$TLS_DIR/cert.pem" ] || [ ! -s "$TLS_DIR/key.pem" ] \
    || { ! _is_le_cert "$TLS_DIR/cert.pem" && ! _cert_covers_dns "$TLS_DIR/cert.pem" "$_hdom"; }; then
    gen_self_cert "$_hdom" "$TLS_DIR"
    log_info "已生成自签证书（CN=$_hdom，SAN=DNS:$_hdom）"
  fi
}

_file_version() { # 读文件里的 SCRIPT_VERSION（不执行文件）
  [ -f "$1" ] || return 1
  sed -n 's/^SCRIPT_VERSION=\([0-9][0-9.]*\)$/\1/p' "$1" 2>/dev/null | head -1
}

_self_file() { # 正在运行的脚本文件（从 stdin/管道运行时为空）
  if [ -n "${INSTALL_SELF_SRC:-}" ]; then
    printf '%s' "$INSTALL_SELF_SRC"
    return 0
  fi
  # "$0" 在 `sh -c "...(curl)..." okxhttp` 与 `sh okxhttp` 下都只是 "okxhttp"，
  # 只看文件是否存在会误判（当前目录恰好有个同名文件 → 以为在跑它 → 永不更新）。
  # 用「文件里的 SCRIPT_VERSION 是否等于正在运行的版本」来判定。
  case "$0" in
    */*) _cand_list=$0 ;;
    *) _cand_list=./$0 ;;
  esac
  for _cand in $_cand_list; do
    [ -f "$_cand" ] || continue
    _fv=$(_file_version "$_cand")
    if [ -n "$_fv" ] && [ "$_fv" = "$SCRIPT_VERSION" ]; then
      printf '%s' "$_cand"
      return 0
    fi
  done
  printf ''
}

_ver_lt() { # a b → 返回 0 表示 a < b（按点分数字比较）
  _a=$1
  _b=$2
  while [ -n "$_a" ] || [ -n "$_b" ]; do
    _x=${_a%%.*}
    _y=${_b%%.*}
    case "$_a" in *.*) _a=${_a#*.} ;; *) _a= ;; esac
    case "$_b" in *.*) _b=${_b#*.} ;; *) _b= ;; esac
    [ -n "$_x" ] || _x=0
    [ -n "$_y" ] || _y=0
    if [ "$_x" -lt "$_y" ]; then return 0; fi
    if [ "$_x" -gt "$_y" ]; then return 1; fi
  done
  return 1
}

installed_version() { # 已安装命令的版本：读文件里的 SCRIPT_VERSION（绝不执行它）
  if [ -f "$BIN_DIR/okxhttp" ]; then
    _bv=$(_file_version "$BIN_DIR/okxhttp")
    if [ -n "$_bv" ]; then
      printf '%s' "$_bv"
      return 0
    fi
  fi
  [ -s "$STACK_DIR/version" ] && cat "$STACK_DIR/version"
}

check_self_update() { # 每次运行都自检：远端 / 运行中 / 已安装三者取最新，该更新就更新
  [ "$(id -u)" -eq 0 ] || return 0
  _inst=$(installed_version)
  [ -n "$_inst" ] || return 0 # 还没装命令 → 交给安装流程
  _body=$(curl -fsSL -m 10 "${SELF_URL}" 2>/dev/null) || _body=
  _rv=$(printf '%s\n' "$_body" | sed -n 's/^SCRIPT_VERSION=\([0-9][0-9.]*\)$/\1/p' | head -1)
  [ -n "$_rv" ] || _rv=
  # 内容不完整（缺 main 入口）就当没拿到远端版本，避免装半截脚本
  if [ -n "$_rv" ] && ! printf '%s\n' "$_body" | grep -q 'main "\$@"'; then _rv=; fi
  _target=$SCRIPT_VERSION
  if [ -n "$_rv" ] && _ver_lt "$_target" "$_rv"; then _target=$_rv; fi
  if ! _ver_lt "$_inst" "$_target"; then return 0; fi # 命令已经是（或比）最新的
  if [ -n "$_rv" ] && [ "$_target" = "$_rv" ]; then
    if _ver_lt "$SCRIPT_VERSION" "$_rv" && [ -t 0 ] && [ -t 1 ] && [ "${YES:-0}" != 1 ]; then
      printf '\n发现新版本 v%s（当前 v%s），现在更新？[Y/n] ' "$_rv" "$SCRIPT_VERSION"
      read -r _ans || _ans=
      case "$_ans" in
        [nN]*) log_info "已跳过更新"; return 0 ;;
      esac
    fi
    _apply_update "$_body" || return 0
  else
    _self_file >/dev/null 2>&1 || return 0
    # 运行中的已经是最新（例如刚 curl 下来的脚本）：把命令同步成它
    install_self
  fi
  if [ ! -f "$0" ] && [ -z "${OKXHTTP_UPDATED:-}" ]; then
    # 一键运行（stdin）时用新版接着跑，避免"更新了但这一次还是旧逻辑"
    export OKXHTTP_UPDATED=1
    log_info "用新版重新执行…"
    exec "$BIN_DIR/okxhttp" "$@"
  fi
}

_apply_update() { # body —— 校验后原子落盘（命令 + version），返回 0 表示已更新
  mkdir -p "$BIN_DIR" "$STACK_DIR"
  printf '%s\n' "$1" >"$BIN_DIR/okxhttp.new" 2>/dev/null || {
    rm -f "$BIN_DIR/okxhttp.new"
    log_warn "更新失败：无法写入 $BIN_DIR"
    return 1
  }
  printf '%s\n' "$1" | grep -q 'main "\$@"' || {
    rm -f "$BIN_DIR/okxhttp.new"
    log_warn "更新失败：内容不完整"
    return 1
  }
  _av=$(_file_version "$BIN_DIR/okxhttp.new")
  [ -n "$_av" ] || {
    rm -f "$BIN_DIR/okxhttp.new"
    log_warn "更新失败：版本号缺失"
    return 1
  }
  chmod 755 "$BIN_DIR/okxhttp.new" && mv -f "$BIN_DIR/okxhttp.new" "$BIN_DIR/okxhttp" || return 1
  printf '%s\n' "$_av" >"$STACK_DIR/version"
  log_info "已更新到 v$_av: $BIN_DIR/okxhttp"
}

install_self() {
  _src=$(_self_file)
  _dst=$BIN_DIR/okxhttp
  [ "$_src" = "$_dst" ] && {
    log_info "已在命令位置运行: $_dst"
    return 0
  }
  if [ -f "$_src" ]; then
    cmp -s "$_src" "$_dst" 2>/dev/null && {
      log_info "命令已是最新: $_dst"
      return 0
    }
    _body=$(cat "$_src")
  else
    log_info "本地无脚本文件，从 $SELF_URL 取回"
    _body=$(curl -fsSL -m 20 "$SELF_URL" 2>/dev/null) || _body=
    [ -n "$_body" ] || {
      log_warn "命令安装失败（可手动下载 $SELF_URL 到 $_dst）"
      return 0
    }
  fi
  _apply_update "$_body" || return 0
  _record_bin "$_dst"
  log_info "已安装命令: $_dst"
}

_print_summary() {
  do_status
  printf '\n----- 节点链接 -----\n'
  gen_links
  printf '\n命令: %s\n\n' "$BIN_DIR/okxhttp"
}

# ---------- 管理面 ----------
svc_restart() {
  case "${INIT_SYS:-none}" in
    systemd) systemctl restart "$1" >/dev/null 2>&1 || log_warn "$1 重启失败" ;;
    openrc) rc-service "$1" restart >/dev/null 2>&1 || log_warn "$1 重启失败" ;;
    *) : ;;
  esac
}

_proto_list() {
  _pl=
  _proto_each _collect_proto
  printf '%s\n' "${_pl# }"
}

_collect_proto() { _pl="$_pl $(_lbl "$1")"; }

_print_port() { # tag port net
  case "$1" in
    "$TAG_XHTTP" | "$TAG_WS") printf ' %s=%s' "$(_lbl "$1")" "$2" ;;
    *) printf ' %s=%s/%s' "$(_lbl "$1")" "$2" "$3" ;;
  esac
}

_print_listen() { # tag port net
  port_in_use "$3" "$2" && _l="$_l $(_lbl "$1")"
  return 0
}

do_status() {
  detect_init
  { [ -f "$STATE" ] || [ -s "$CONFIG" ]; } || {
    log_warn "尚未部署（既无 $STATE 也无 $CONFIG）"
    return 0
  }
  load_state
  # 老部署没有 v6：只补 v6（不动 v4），补到就写回状态，链接也跟着有 v6
  _fill_public_ip6
  printf '\n===== 部署状态 =====\n'
  printf '脚本版本   : v%s（已安装命令: v%s）\n' "$SCRIPT_VERSION" "$(installed_version)"
  printf '节点名     : %s\n' "${NODE_NAME:-?}"
  printf '公网 IP    : %s%s\n' "${PUBLIC_IP:-?}" \
    "$([ -n "${PUBLIC_IP6:-}" ] && [ "${PUBLIC_IP6}" != "${PUBLIC_IP}" ] && printf ' / %s' "$PUBLIC_IP6")"
  printf '协议       : %s\n' "$(_proto_list)"
  if _argo_on; then
    printf 'Argo 模式  : %s%s%s\n' "${ARGO_MODE:-?}" \
      "$([ -n "${ARGO_DOMAIN:-}" ] && printf ' (%s)' "$ARGO_DOMAIN")" \
      "$([ -n "${ARGO_AUTH:-}" ] && printf ' [token 已保存]')"
    printf '隧道传输   : %s\n' "$([ "${ENABLE_WS:-0}" = 1 ] && echo ws || echo xhttp)"
    printf '连接器协议 : %s\n' "${ARGO_PROTO_USED:-${ARGO_PROTO:-auto}}"
  fi
  printf '端口       :'
  _proto_each _print_port
  printf '\n'
  printf '服务       : xray=%s argo=%s 调度=%s  init=%s\n' \
    "$(svc_running xray && echo running || echo stopped)" \
    "$(svc_running argo && echo running || echo stopped)" \
    "$(svc_running "$SVC_SCHED" && echo running || echo stopped)" "${INIT_SYS}"
  _l=
  _proto_each _print_listen
  printf '实际监听   :%s\n' "${_l:- 无}"
  printf 'DNS 解析   : %s\n' "$([ "${DNS_DOH:-yes}" = yes ] && echo 'Xray DoH' || echo '系统 DNS')"
  if [ "${WARP:-no}" = yes ]; then
    printf 'WARP       : %s → WARP  TUN=%s\n' "${WARP_ROUTE:-bittorrent}" "${WARP_TUN_MODE:-?}"
  else
    printf 'WARP       : 未启用\n'
  fi
  printf '证书       : %s\n' "$(_cert_summary)"
  if [ -n "${HY2_BRUTAL_UP:-}" ]; then
    printf 'hy2 带宽   : %s↑ / %s↓ Mbps（Brutal）\n' "$HY2_BRUTAL_UP" "${HY2_BRUTAL_DOWN:-$HY2_BRUTAL_UP}"
  fi
  if [ "${SUB:-yes}" = yes ] && [ -n "${SUB_KEY:-}" ]; then
    printf '订阅       : %s/%s\n' "$SUB_URL" "$SUB_KEY"
  fi
  printf '配置       : %s\n' "$CONFIG"
  printf '部署目录   : %s\n' "$STACK_DIR"
}

_cert_summary() {
  [ -s "$TLS_DIR/cert.pem" ] || {
    printf '无'
    return 0
  }
  _iss=$(openssl x509 -in "$TLS_DIR/cert.pem" -noout -issuer 2>/dev/null | sed 's/^issuer=//')
  _end=$(openssl x509 -in "$TLS_DIR/cert.pem" -noout -enddate 2>/dev/null | sed 's/^notAfter=//')
  if openssl x509 -in "$TLS_DIR/cert.pem" -noout -checkend 259200 >/dev/null 2>&1; then
    printf '%s  到期 %s' "${_iss:-?}" "${_end:-?}"
  else
    printf '%s  到期 %s  [剩余不足 3 天]' "${_iss:-?}" "${_end:-?}"
  fi
}

do_certinfo() {
  load_state
  [ -s "$TLS_DIR/cert.pem" ] || {
    log_warn "未找到证书（$TLS_DIR/cert.pem）"
    return 1
  }
  printf '\n===== 证书信息 =====\n'
  printf '文件    : %s\n' "$TLS_DIR/cert.pem"
  openssl x509 -in "$TLS_DIR/cert.pem" -noout -subject -issuer -dates 2>/dev/null
  printf 'SAN     : %s\n' "$(openssl x509 -in "$TLS_DIR/cert.pem" -noout -ext subjectAltName 2>/dev/null | sed -n '2p' | sed 's/^ *//')"
  printf 'SHA256  : %s\n' "$(cert_pin_sha256 "$TLS_DIR/cert.pem")"
  printf '客户端  : %s\n' "$([ "${HY2_CERT_EFFECTIVE:-self}" = le ] && echo '系统信任链校验（LE）' || echo "pinSHA256=$(_cert_pin_hex)（自签，链接里已带）")"
  if _is_le_cert "$TLS_DIR/cert.pem"; then
    printf '自动续期: %s（每天检查一次，剩余 <4 天则重签）\n' "$([ "$(svc_running "$SVC_SCHED" && echo up || echo down)" = up ] && echo '调度服务运行中' || echo '调度服务未运行，可 okxhttp --renew 手动续期')"
  else
    printf '自动续期: 未配置（自签证书 365 天，无需续期）\n'
  fi
}

_cert_serial() { openssl x509 -in "$1" -noout -serial 2>/dev/null | cut -d= -f2; }

do_renew() {
  load_state
  if ! _is_le_cert "$TLS_DIR/cert.pem"; then
    log_warn "当前不是 LE 证书，无需续期"
    return 1
  fi
  _before=$(_cert_serial "$TLS_DIR/cert.pem")
  log_info "向 Let's Encrypt 续期 $PUBLIC_IP …"
  _lego_run "$PUBLIC_IP" --renew-days 4 || {
    log_err "续期失败（旧证书继续生效）：$STACK_DIR/lego.log"
    return 1
  }
  _install_le_files "$PUBLIC_IP" || {
    log_err "没取到新证书（旧证书继续生效）：$STACK_DIR/lego.log"
    return 1
  }
  if [ "$(_cert_serial "$TLS_DIR/cert.pem")" != "$_before" ]; then
    log_info "已换新证书，重启 xray"
    svc_restart xray
  else
    log_info "证书未变化，不重启"
  fi
  do_certinfo
}

# ---------- 直连协议端口（REALITY / Hysteria2） ----------
_valid_port() {
  case "${1:-}" in '' | *[!0-9]*) return 1 ;; esac
  [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

_set_brutal() { # "200/500" | "200" | "0" —— 0 是合法带宽，运行时会自然回落 BBR
  if [ -z "${1:-}" ]; then # 未配置
    HY2_BRUTAL_UP='' HY2_BRUTAL_DOWN=''
    export HY2_BRUTAL_UP HY2_BRUTAL_DOWN
    return 0
  fi
  case "$1" in
    */*) _up=${1%%/*} _down=${1#*/} ;;
    *) _up=$1 _down=$1 ;;
  esac
  case "$_up" in '' | *[!0-9]*) return 1 ;; esac
  case "$_down" in '' | *[!0-9]*) return 1 ;; esac
  HY2_BRUTAL_UP=$_up HY2_BRUTAL_DOWN=$_down
  export HY2_BRUTAL_UP HY2_BRUTAL_DOWN
}

_ask_brutal() { # 交互里问 Brutal 带宽
  _cur=''
  [ -n "${HY2_BRUTAL_UP:-}" ] && _cur="${HY2_BRUTAL_UP}/${HY2_BRUTAL_DOWN:-$HY2_BRUTAL_UP}"
  printf 'Hysteria2 Brutal 带宽 Mbps（上行/下行，如 200/500）%s：' \
    "$([ -n "$_cur" ] && printf ' [%s]（回车保持）' "$_cur")"
  read -r _bw || _bw=
  [ -n "$_bw" ] || return 0
  _set_brutal "$_bw" || log_warn "带宽格式不对（Mbps 数字，如 200 或 200/500；0=不启用），保持原值"
}

_ask_node_name() { # 交互里问节点名（回车保持当前/主机名）
  _nn=${NODE_NAME:-$(hostname 2>/dev/null || echo node)}
  printf '节点名 [%s]（回车保持）：' "$_nn"
  read -r _new || _new=
  [ -n "$_new" ] || return 0
  if printf '%s' "$_new" | grep -q '[[:space:]#?&/]'; then
    log_warn "节点名不能包含空白或 # ? & /，保持 $_nn"
    return 1
  fi
  NODE_NAME=$_new
  export NODE_NAME
}

_ask_port() { # tag port net —— 交互安装时问直连端口（回车保持）
  printf '%s 端口 [%s]（回车保持）：' "$(_lbl "$1")" "$2"
  read -r _a || _a=
  [ -n "$_a" ] || return 0
  _valid_port "$_a" || {
    log_warn "端口必须是 1-65535 的整数，保持 $2"
    return 0
  }
  _apv=$(_proto_field "$1" 3)
  eval "$_apv=\$_a"
  eval "export $_apv"
}

_inbound_port() { # tag -> 端口
  jq -r --arg t "$1" '[.inbounds[] | select(.tag == $t) | .port] | first // empty' "$CONFIG" 2>/dev/null
}

set_inbound_port() { # tag port —— 只改该入站端口，校验通过才原子替换
  _valid_port "$2" || return 1
  _tmp="$CONFIG.new.json"
  if ! jq --arg t "$1" --argjson p "$2" '(.inbounds[] | select(.tag == $t) | .port) = $p' "$CONFIG" >"$_tmp" 2>/dev/null; then
    rm -f "$_tmp"
    return 1
  fi
  test_config "$_tmp" || {
    rm -f "$_tmp"
    return 1
  }
  chmod 600 "$_tmp" && mv "$_tmp" "$CONFIG"
}

_change_port() { # tag proto 名称 当前端口
  _tag=$1
  _proto=$2
  _name=$3
  _cur=$4
  printf '  %s 新端口 [%s]（回车保持）：' "$_name" "$_cur"
  read -r _in || _in=
  [ -n "$_in" ] || {
    log_info "$_name 保持 $_cur/$_proto"
    return 2
  }
  _valid_port "$_in" || {
    log_err "端口必须是 1-65535 的整数"
    return 1
  }
  [ "$_in" = "$_cur" ] && {
    log_info "$_name 保持 $_in/$_proto"
    return 2
  }
  _clash=
  for _op in $(jq -r --arg t "$_tag" '.inbounds[] | select(.tag != $t) | "\(.port)/\(if .streamSettings.network == "hysteria" then "udp" else "tcp" end)"' "$CONFIG" 2>/dev/null); do
    [ "$_op" = "$_in/$_proto" ] && _clash=1
  done
  [ -n "$_clash" ] && {
    log_err "$_name 不能用 $_in/$_proto：本服务其它入站已占用"
    return 1
  }
  if _port_blocked "$_proto" "$_in"; then
    log_err "$_name 端口 $_in/$_proto 被其它进程占用"
    return 1
  fi
  set_inbound_port "$_tag" "$_in" || {
    log_err "$_name 改到 $_in/$_proto 失败"
    return 1
  }
  log_info "$_name 端口：$_cur -> $_in（$_proto）"
  return 0
}

do_rename() { # 改节点名（只影响链接与订阅，不动服务）
  load_state
  _ask_node_name || return 1
  save_state
  log_info "节点名已改为: ${NODE_NAME}"
  if [ "${SUB:-yes}" = yes ] && [ -n "${SUB_KEY:-}" ]; then
    sub_push >/dev/null 2>&1 && log_info "订阅已同步"
  fi
  log_info "新链接用 okxhttp --info 查看"
}

do_ports() {
  detect_init
  load_state
  _DIRECT_ONLY=1
  _items=
  _proto_each _collect_direct
  [ -n "$_items" ] || {
    log_warn "当前没有启用的直连协议"
    return 1
  }
  printf '\n======== 直连协议端口 ========\n'
  _i=0
  for _it in $_items; do
    _i=$((_i + 1))
    _p=${_it#*|}
    printf ' %d) %-10s %s/%s\n' "$_i" "$(_lbl "${_it%%|*}")" "${_p%%|*}" "${_p#*|}"
  done
  printf ' a) 全部\n 0) 返回\n选择: '
  read -r _c || _c=
  case "$_c" in
    0 | '') return 0 ;;
    a | A) _sel=$_items ;;
    *[!0-9]*)
      log_warn "无效选择"
      return 1
      ;;
    *)
      _i=0
      _sel=
      for _it in $_items; do
        _i=$((_i + 1))
        [ "$_i" = "$_c" ] && _sel=$_it
      done
      [ -n "$_sel" ] || {
        log_warn "无效选择"
        return 1
      }
      ;;
  esac
  _changed=0
  for _it in $_sel; do
    _tag=${_it%%|*}
    _p=${_it#*|}
    _change_port "$_tag" "${_p#*|}" "$(_lbl "$_tag")" "${_p%%|*}" && _changed=1
  done
  [ "$_changed" = 1 ] || {
    log_info "端口未变化"
    return 0
  }
  # 端口变量写回状态，链接与订阅都以配置为准
  for _it in $_items; do
    _tag=${_it%%|*}
    _pvar=$(_proto_field "$_tag" 3)
    _newp=$(_inbound_port "$_tag")
    [ -n "$_newp" ] && eval "$_pvar=\$_newp" && eval "export $_pvar"
  done
  save_state
  log_info "重启 xray 使新端口生效…"
  svc_restart xray
  if wait_serving 15; then
    log_info "端口已确认监听"
  else
    log_warn "端口未监听，看 okxhttp --log=xray"
  fi
  if [ "${SUB:-yes}" = yes ] && [ -n "${SUB_KEY:-}" ]; then
    sub_push >/dev/null 2>&1 && log_info "订阅已同步"
  fi
  log_info "节点链接已更新，用 okxhttp --info 查看"
}

_collect_direct() { # tag port net
  _items="$_items $1|$2|$3"
}


do_log() { # 目标: xray|argo|空(两个都看)
  detect_init
  _n=${LOG_LINES:-50}
  _one() {
    case "$1" in
      argo)
        if [ -s "$ARGO_LOG" ]; then tail -n "$_n" "$ARGO_LOG"; else log_warn "无 Argo 日志（$ARGO_LOG）"; fi
        ;;
      xray)
        if [ -s "$STACK_DIR/xray.log" ]; then
          tail -n "$_n" "$STACK_DIR/xray.log"
        elif [ "${INIT_SYS:-none}" = systemd ] && command_exists journalctl; then
          journalctl -u xray -n "$_n" --no-pager 2>/dev/null
        else
          log_warn "无 xray 日志（$STACK_DIR/xray.log）；重新部署一次即可开始记录"
        fi
        ;;
    esac
  }
  case "${1:-all}" in
    xray) _one xray ;;
    argo) _one argo ;;
    all)
      printf '\n===== xray（最近 %s 行）=====\n' "$_n"
      _one xray
      printf '\n===== argo（最近 %s 行）=====\n' "$_n"
      _one argo
      ;;
    *) die "--log 只支持 xray / argo" ;;
  esac
}

do_restart() {
  detect_init
  [ -f "$STATE" ] || {
    log_warn "尚未部署，无需重启"
    return 0
  }
  load_state
  log_info "重启 xray（init=${INIT_SYS}）…"
  svc_restart xray
  if _argo_on; then
    log_info "重启 argo 连接器…"
    svc_restart argo
  fi
  if svc_running "$SVC_SCHED"; then svc_restart "$SVC_SCHED" >/dev/null 2>&1 || true; fi
  if wait_serving 10; then
    log_info "端口已确认监听"
  else
    log_warn "重启后端口未全部监听（查 --log=xray）"
  fi
  printf 'xray=%s argo=%s\n' \
    "$(svc_running xray && echo running || echo stopped)" \
    "$(svc_running argo && echo running || echo stopped)"
}

_menu() {
  while :; do
    if _deployed; then
      do_status
      printf '\n---------------- 操作 ----------------\n'
      printf ' 1) 重启服务        2) 查看日志       3) 节点链接\n'
      printf ' 4) 同步订阅        5) 重置订阅 key\n'
      printf ' 6) 修改直连端口    7) 修改节点名     8) 证书信息\n'
      printf ' 9) 立即续期        r) 重装（沿用当前） u) 卸载\n'
      printf ' 0) 退出\n'
    else
      printf '\n尚未部署\n\n 1) 安装      0) 退出\n'
    fi
    printf '选择: '
    read -r _c || _c=
    case "$_c" in
      1)
        if _deployed; then
          need_root
          do_restart
        else
          _do_install
          return 0
        fi
        ;;
      2)
        printf '看哪个日志？1=xray 2=argo 3=两个 [3]：'
        read -r _w || _w=
        case "$_w" in 1) do_log xray ;; 2) do_log argo ;; *) do_log all ;; esac
        ;;
      3) do_info ;;
      4)
        load_state
        SUB=yes
        if sub_push; then
          log_info "已同步: $SUB_URL/$SUB_KEY"
          install_sched_service
        fi
        ;;
      5)
        load_state
        printf '确认重置订阅 key？旧 key 的内容会被清空（y/N）：'
        read -r _y || _y=
        case "$_y" in
          y | Y) sub_reset ;;
          *) log_info "已取消" ;;
        esac
        ;;
      6) need_root; do_ports ;;
      7) need_root; do_rename ;;
      8) do_certinfo ;;
      9) need_root; do_renew ;;
      r | R)
        _do_install
        return 0
        ;;
      u | U)
        need_root
        printf '确认卸载？证书目录会保留（y/N）：'
        read -r _y || _y=
        case "$_y" in
          y | Y)
            do_uninstall
            return 0
            ;;
          *) log_info "已取消" ;;
        esac
        ;;
      0 | '') return 0 ;;
      *) log_warn "无效选择" ;;
    esac
  done
}

install_all() {
  need_root
  trap _cleanup EXIT INT TERM
  detect_init
  install_deps
  detect_arch >/dev/null
  log_info "环境: OS=${OS_ID} arch=${ARCH_RAW} init=${INIT_SYS}"
  fetch_core
  _record_bin "$XRAY_BIN"
  _record_bin "$CLOUDFLARED_BIN"

  PUBLIC_IP=${PUBLIC_IP:-$(public_ip)}
  if [ -z "${PUBLIC_IP6:-}" ]; then
    [ -n "${_PROBED:-}" ] || _probe_all
    PUBLIC_IP6=${PROBE_IP_V6:-}
  fi
  [ -n "$PUBLIC_IP" ] || die "无法获取公网 IPv4（可用 PUBLIC_IP 指定）"
  export PUBLIC_IP

  if _argo_on; then
    if [ "${ARGO_MODE}" = temp ]; then
      ensure_hosts_entry api.trycloudflare.com || log_warn "创建临时隧道可能失败（api.trycloudflare.com 解析不了）"
    fi
    # 边缘地址用 DoH 解析后直接给 cloudflared（--edge），彻底不依赖系统 DNS / SRV
    ARGO_EDGE_ARGS=$(argo_edge_args)
    if [ -n "$ARGO_EDGE_ARGS" ]; then
      ARGO_EDGE_MODE=doh
      set -- $ARGO_EDGE_ARGS
      log_info "边缘地址（DoH 解析）：共 $(( $# / 2 )) 个，已通过 --edge 指定"
    else
      ARGO_EDGE_MODE=srv
      log_warn "DoH 未能解析边缘地址，回退为 cloudflared 自己查 SRV"
      if ! doh_query _v2-origintunneld._tcp.argotunnel.com SRV 33 >/dev/null 2>&1 \
        && ! nslookup -type=SRV _v2-origintunneld._tcp.argotunnel.com 2>/dev/null | grep -q 'service ='; then
        die "系统 DNS 无法解析 argotunnel 的 SRV 记录，且 DoH 也没拿到边缘地址"
      fi
    fi
    export ARGO_EDGE_ARGS ARGO_EDGE_MODE
  fi
  if [ "${ENABLE_XHTTP:-0}" = 1 ] && [ "${ARGO_MODE:-temp}" = token ]; then
    argo_probe_ingress || log_warn "继续使用 XHTTP_PORT=${XHTTP_PORT}"
  fi
  preflight

  _ensure_keys
  _ensure_cert
  if [ "${WARP:-no}" = yes ]; then
    ensure_warp
    WARP_ENABLED=1
    WARP_TUN_MODE=$(detect_tun_mode)
    if [ "$WARP_TUN_MODE" = kernel ]; then
      log_info "WARP 已启用：${WARP_ROUTE} → WARP 出站（内核 TUN）"
    else
      log_info "WARP 已启用：${WARP_ROUTE} → WARP 出站（内置 TCP/IP 栈，无 TUN 权限）"
    fi
  else
    WARP_ENABLED=0
  fi
  [ -f "$CONFIG" ] && cp -p "$CONFIG" "$CONFIG.prev"
  build_config "$CONFIG"
  log_info "配置已通过 xray 校验: $CONFIG"

  # 校验全部通过后再停旧服务，避免"停掉后失败"把线上服务留在停止状态
  svc_stop xray 2>/dev/null || true
  SVC_LOG=$STACK_DIR/xray.log svc_install xray "$XRAY_BIN run -c $CONFIG"
  if ! wait_serving 10 && [ "${WARP_ENABLED:-0}" = 1 ] && [ "${WARP_TUN_MODE:-}" = kernel ]; then
    # 内核 TUN 建不起来（容器常见）→ 自动回落内置栈重试一次
    log_warn "内核 TUN 启动失败，回落到内置 TCP/IP 栈重试"
    WARP_TUN_MODE=builtin
    build_config "$CONFIG"
    svc_stop xray 2>/dev/null || true
    SVC_LOG=$STACK_DIR/xray.log svc_install xray "$XRAY_BIN run -c $CONFIG" || true
    wait_serving 10 && log_info "已用内置栈启动"
  fi
  if ! wait_serving 10; then
    log_err "xray 起来后端口没有监听，回滚到上一份配置"
    if [ -f "$CONFIG.prev" ]; then
      mv "$CONFIG.prev" "$CONFIG"
      svc_stop xray 2>/dev/null || true
      SVC_LOG=$STACK_DIR/xray.log svc_install xray "$XRAY_BIN run -c $CONFIG" || true
      wait_serving 10 && log_info "已回滚并恢复服务"
    fi
    tail -20 "$STACK_DIR/xray.log" 2>/dev/null >&2 || true
    die "部署失败（端口未监听），线上服务已恢复为上一份配置"
  fi
  rm -f "$CONFIG.prev"
  log_info "xray 服务已启动（端口已确认监听）"

  if _argo_on; then
    argo_start
    svc_running argo || [ "${INIT_SYS:-none}" = none ] || die "argo 连接器未运行"
  fi

  save_state
  install_self
  if [ "${SUB:-yes}" = yes ]; then
    if [ -z "${SUB_KEY:-}" ]; then
      SUB_KEY=$(gen_uuid)
      log_info "订阅 key 已生成: $SUB_KEY"
    fi
    if sub_push; then
      log_info "订阅已就绪: $SUB_URL/$SUB_KEY"
    else
      log_warn "订阅推送失败，稍后可执行 okxhttp --sub-reset 重试"
    fi
  fi
  install_sched_service
  _print_summary
}

main() {
  # shellcheck disable=SC2034
  MAIN_RAN=1
  # 快照用户显式指定的端口（load_state/hydrate 会往同名变量里写状态值）
  _ENV_XHTTP_PORT=${XHTTP_PORT:-} _ENV_WS_PORT=${WS_PORT:-}
  _ENV_XHTTP=${XHTTP:-} _ENV_REALITY=${REALITY:-} _ENV_HY2=${HY2:-}
  _ENV_PORTS_SNAPSHOTTED=1
  check_self_update "$@" || true # 每次运行都自检
  parse_args "$@"
  if [ -z "$MODE" ]; then
    if [ "${YES:-0}" = 1 ]; then
      MODE=install
    elif [ -t 0 ]; then
      _menu
      return 0
    else
      die "非交互环境：请加 --yes 并用环境变量指定协议（--help 查看全部选项）"
    fi
  fi
  case "$MODE" in
    install) _do_install ;;
    info) do_info ;;
    status) do_status ;;
    restart) need_root; do_restart ;;
    log) do_log "${LOG_TARGET:-all}" ;;
    renew) need_root; do_renew ;;
    certinfo) do_certinfo ;;
    daemon) need_root; do_daemon ;;
    subsync) need_root; sub_sync ;;
    subreset) need_root; sub_reset ;;
    uninstall) need_root; do_uninstall ;;
    *) die "未知模式: $MODE" ;;
  esac
}

# ---------- 环境探测 ----------
pick_xray_asset() {
  case "$1" in
    x86_64 | amd64) echo Xray-linux-64.zip ;;
    aarch64 | arm64) echo Xray-linux-arm64-v8a.zip ;;
    armv7l | armv7) echo Xray-linux-arm32-v7a.zip ;;
    i386 | i686 | x86) echo Xray-linux-32.zip ;;
    *) echo '' ;;
  esac
}

pick_cloudflared_asset() {
  case "$1" in
    x86_64 | amd64) echo cloudflared-linux-amd64 ;;
    aarch64 | arm64) echo cloudflared-linux-arm64 ;;
    armv7l | armv7) echo cloudflared-linux-arm ;;
    i386 | i686 | x86) echo cloudflared-linux-386 ;;
    *) echo '' ;;
  esac
}

detect_arch() {
  ARCH_RAW=$(uname -m)
  # shellcheck disable=SC2034
  ARCH=$(pick_xray_asset "$ARCH_RAW") # 供调用方读取
  printf '%s\n' "$ARCH_RAW"
}

detect_os() {
  OS_ID=other
  OS_PKG=
  if [ -r /etc/os-release ]; then
    _id=$(sed -n 's/^ID=//p' /etc/os-release | tr -d '"' | head -1)
    case "$_id" in
      debian | ubuntu) OS_ID=debian ;;
      alpine) OS_ID=alpine ;;
    esac
  fi
  case "$OS_ID" in
    debian) OS_PKG=apt ;;
    alpine) OS_PKG=apk ;;
  esac
}

public_ip() { # 本机出口 IP：优先 v4（v6-only 时返回 v6）；兜底读路由表
  [ -n "${_PROBED:-}" ] || _probe_all
  if [ -n "${PROBE_IP_V4:-}" ]; then
    printf '%s' "$PROBE_IP_V4"
    return 0
  fi
  if [ -n "${PROBE_IP_V6:-}" ]; then
    printf '%s' "$PROBE_IP_V6"
    return 0
  fi
  ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -1
}

_v6_addr() { # 已知的公网 v6（来自安装探测/状态），不联网
  printf '%s' "${PUBLIC_IP6:-}"
}

LISTEN_ANY='::'   # 公网入站：v6 通配即双栈（Linux 默认 v4 映射）
LISTEN_LOCAL='::1' # 隧道入站：只回环

_is_loopback() { # 监听地址是否只回环（旧配置里可能是 127.0.0.1）
  case "$1" in
    ::1 | 127.* | localhost) return 0 ;;
  esac
  return 1
}

_bracket() { # IPv6 需要 [] 包起来才能拼进 URL
  case "$1" in
    *:*) printf '[%s]' "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}

missing_deps() {
  _out=
  for _c in curl jq unzip openssl; do
    command_exists "$_c" || _out="$_out $_c"
  done
  # Alpine/OpenRC：守护进程 supervise-daemon 由 openrc 包提供（部分是独立包），缺失时必须在这里补
  if [ "${INIT_SYS:-}" = openrc ] && ! command_exists supervise-daemon && [ ! -x /sbin/supervise-daemon ]; then
    _out="$_out supervise-daemon"
  fi
  printf '%s\n' "${_out# }"
}

_dep_pkgs() { # 依赖名 -> 候选包名（按顺序尝试）
  case "$1" in
    supervise-daemon) printf 'supervise-daemon openrc' ;; # 新版独立包 / 老版并入 openrc
    *) printf '%s' "$1" ;;
  esac
}

install_deps() {
  detect_os
  detect_init
  _miss=$(missing_deps)
  [ -z "$_miss" ] && return 0
  log_info "安装依赖: $_miss"
  case "$OS_PKG" in
    apt)
      apt-get update -qq >/dev/null 2>&1 || true
      DEBIAN_FRONTEND=noninteractive apt-get install -y -qq ca-certificates curl jq unzip openssl >/dev/null
      ;;
    apk)
      apk add --no-cache ca-certificates >/dev/null 2>&1 || true
      for _d in $_miss; do
        _ok=
        for _p in $(_dep_pkgs "$_d"); do
          if apk add --no-cache "$_p" >/dev/null 2>&1; then _ok=1; break; fi
        done
        [ -n "$_ok" ] || log_warn "装不上: $_d（已尝试包: $(_dep_pkgs "$_d")）"
      done
      ;;
    *) die "无法识别包管理器，请手动安装: $_miss" ;;
  esac
  _miss=$(missing_deps)
  [ -z "$_miss" ] || die "依赖安装失败，仍缺: $_miss"
}

# ---------- 内核下载 ----------
fetch_dl() { # url out —— 失败时把 curl 的真实原因打出来，并允许镜像覆盖
  _try=1
  while [ "$_try" -le 2 ]; do
    if _err=$(curl -fsSL --retry 3 --retry-delay 1 --connect-timeout 10 -o "$2" "$1" 2>&1); then
      [ -s "$2" ] && return 0
      log_warn "下载内容为空: $1"
    else
      log_warn "下载失败（第 ${_try}/2 次）: $1"
      printf '%s\n' "$_err" | tail -3 >&2
    fi
    rm -f "$2"
    [ "$_try" -lt 2 ] && sleep 2
    _try=$((_try + 1))
  done
  return 1
}

fetch_core() {
  mkdir -p "$BIN_DIR"
  _arch=$(detect_arch)
  if [ "${FORCE_FETCH:-0}" = 1 ] || [ ! -x "$BIN_DIR/xray" ]; then
    _asset=$(pick_xray_asset "$_arch")
    [ -n "$_asset" ] || die "不支持的架构: $_arch"
    log_info "下载 Xray 内核 ($_asset)"
    _tmp="$BIN_DIR/.xray.zip"
    fetch_dl "https://github.com/XTLS/Xray-core/releases/latest/download/$_asset" "$_tmp" || die "Xray 下载失败"
    (cd "$BIN_DIR" && unzip -oq .xray.zip xray) || die "Xray 解压失败"
    rm -f "$_tmp"
    chmod +x "$BIN_DIR/xray"
  fi
  XRAY_BIN="$BIN_DIR/xray"
  "$XRAY_BIN" version >/dev/null 2>&1 || die "xray 无法执行: $XRAY_BIN"

  if [ "${FORCE_FETCH:-0}" = 1 ] || [ ! -x "$BIN_DIR/cloudflared" ]; then
    _casset=$(pick_cloudflared_asset "$_arch")
    [ -n "$_casset" ] || die "cloudflared 不支持该架构: $_arch"
    log_info "下载 cloudflared ($_casset)"
    fetch_dl "https://github.com/cloudflare/cloudflared/releases/latest/download/$_casset" "$BIN_DIR/cloudflared" || die "cloudflared 下载失败"
    chmod +x "$BIN_DIR/cloudflared"
  fi
  CLOUDFLARED_BIN="$BIN_DIR/cloudflared"
  "$CLOUDFLARED_BIN" --version >/dev/null 2>&1 || die "cloudflared 无法执行: $CLOUDFLARED_BIN"
}

[ "${STACK_LIB_ONLY:-0}" = 1 ] || main "$@"
